/* ---- playback ---- */
const seekTo=s=>{ST.elapsed=s;const a=A();if(a)a.currentTime=s};
function play(i){ST.now=i;ST.playing=true;seekTo(0);if(fadeMs()){fadeG=0;applyVol();ramp(1,fadeMs())}else if(fadeG!==1){fadeG=1;applyVol()}buzz()}
function go(d){if(d<0&&ST.elapsed>3){seekTo(0);return}play(d>0?(ST.mode===2?rand():step(1)):step(-1))}
function setPlay(p){if(p){ST.playing=true;if(fadeMs()){fadeG=0;applyVol();ramp(1,fadeMs())}paintPlay()}
 else if(fadeMs()&&ST.playing&&!fading){fading=true;paintPlay(false);ramp(0,fadeMs(),()=>{fading=false;ST.playing=false;fadeG=1;applyVol();paintPlay()})}
 else{ST.playing=false;paintPlay()}}
