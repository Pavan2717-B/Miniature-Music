function renderPi(){const p=curPl();if(!p)return;let h;
 if(piMode==="songs"){const ix=(p.s.length?p.s:T.map((_,i)=>i)).filter(i=>T[i]);h=`<div class="qh"><button id="pib" class="back" aria-label="Back">${svg(IC.back)}</button><b style="flex:1">Use a song's cover</b><button id="pix" class="done">Close</button></div><div class="scroll"><div class="pgrid">${ix.map(i=>`<button class="pit" data-pi="s${i}"><img src="${T[i].img}" alt=""></button>`).join("")}</div></div>`}
 else h=`<div class="qh"><b>Playlist image</b><button id="pix" class="done">Close</button></div><div class="scroll"><div class="pia"><button class="ab" data-pi="photo">${svg(IC.img)}From photos</button><button class="ab" data-pi="songs">${svg(IC.songs)}Song cover</button><button class="ab" data-pi="auto">${svg(IC.album)}Auto collage</button></div><p class="note">Illustrations</p><div class="pgrid">${PLP.map((_,n)=>`<button class="pit${p.art===n&&!p.img?" on":""}" data-pi="a${n}"><img src="${plArtUrl(n)}" alt=""></button>`).join("")}</div></div>`;
 $("#pi").innerHTML=h}
function openPi(){if(!curPl())return;piMode="main";renderPi();$("#pi").classList.add("open")}
