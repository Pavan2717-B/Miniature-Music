 if(i===ST.now){setPlay(true);rq();openNP()}else play(i);$("#qs").classList.remove("open")});
const fitArt=()=>{const a=$("#art"),w=$("#artw"),r=np.getBoundingClientRect(),h=w.getBoundingClientRect();if(h.height>0)a.style.height=Math.round(h.bottom-r.top+44)+"px"};addEventListener("resize",fitArt);addEventListener("orientationchange",()=>setTimeout(fitArt,200));addEventListener("load",fitArt);setTimeout(fitArt,0);
const openNP=()=>{np.classList.add("open");fitArt();drawWave()},closeNP=()=>{np.classList.remove("open");$("#qs").classList.remove("open");$("#es").classList.remove("open");$("#eqgo").classList.remove("on")};
$("#mini").onclick=e=>{if(!e.target.closest("button,#m-wave"))openNP()};$("#close").onclick=closeNP;
$("#qb").onclick=()=>{$("#es").classList.remove("open");$("#qs").classList.add("open")};$("#qx").onclick=()=>$("#qs").classList.remove("open");
$("#eqgo").onclick=()=>{$("#qs").classList.remove("open");$("#es").classList.add("open");$("#eqgo").classList.add("on")};
