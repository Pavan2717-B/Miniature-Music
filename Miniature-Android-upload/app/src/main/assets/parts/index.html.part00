addEventListener("load",()=>{applyCfg();eqApply();const rp=store.get("pos",null);if(cfg.resume&&rp&&rp[0]===ST.now&&rp[1]>3&&A()){ST.elapsed=rp[1];A().currentTime=rp[1]}});
/* ---- main loop ---- */
function frame(){const a=A();const nowT=performance.now();if(lastT&&ST.playing&&a&&!a.paused)stats.secs+=Math.min(1,(nowT-lastT)/1000);lastT=nowT;if(nowT-lastSave>8000){lastSave=nowT;store.set("stats",stats)}
 if(shown!==ST.now){if(shown>=0&&sleepEnd){ST.playing=false;sleepEnd=false;sleepI=0;paintSleep();toast("Sleep timer: stopped")}if(shown>=0&&ST.playing){rec(ST.now);countPlay()}paint()}
 if(a&&!ST.dragging){if(ST.playing&&a.paused)a.play().catch(()=>{});if(!ST.playing&&!a.paused)a.pause();ST.elapsed=a.currentTime}
 if(ST.levelFn&&ST.playing&&a&&!a.paused){const L=ST.liveEnv[ST.now]||(ST.liveEnv[ST.now]=new Float32Array(LIVE).fill(-1)),i=Math.min(LIVE-1,Math.floor(ST.elapsed/T[ST.now].dur*LIVE)),v=Math.max(0,Math.min(1,ST.levelFn()));L[i]=L[i]<0?v:L[i]*.5+v*.5;const H=HL[ST.now]||(HL[ST.now]=new Float32Array(Math.ceil(T[ST.now].dur*HZ)+2).fill(-1)),j=Math.floor(ST.elapsed*HZ);if(j>=0&&j<H.length)H[j]=H[j]<0?v:H[j]*.5+v*.5}
 if(sleepAt&&cfg.slfade){const rem=sleepAt-Date.now();if(rem<20000){fadeG=Math.max(0,rem/20000);applyVol()}}
 if(sleepAt&&Date.now()>=sleepAt){sleepAt=0;sleepI=0;ST.playing=false;fadeG=1;applyVol();paintSleep();toast("Sleep timer: stopped")}
 if(!fading&&shownPlay!==ST.playing)paintPlay();
 const t=T[ST.now],s=ST.elapsed|0;
 if(s!==lastS){lastS=s;$("#el").textContent=fmt(s);if(ST.playing&&s%3===0)store.set("pos",[ST.now,s]);if($("#v-set").classList.contains("on"))updSleepSt();if("mediaSession"in navigator)try{navigator.mediaSession.setPositionState({duration:t.dur,position:Math.min(s,t.dur),playbackRate:1})}catch(e){}}
 if(np.classList.contains("open")){if((fr++&1)===0)drawWave()}else drawMini();
 requestAnimationFrame(frame)}
applyCfg();setTab("songs");paintMode();paintSleep();paintEQ();paintDev();renderSettings();if(cfg.shake&&!(window.DeviceMotionEvent&&DeviceMotionEvent.requestPermission))addEventListener("devicemotion",onMotion);requestAnimationFrame(frame);
 /* ---- songs from the phone's file manager: they are added after the built-in songs and kept on this device ---- */
 const SDB={db:null,open(){return this.db?Promise.resolve(this.db):new Promise((ok,no)=>{try{const r=indexedDB.open("miniature-songs",1);r.onupgradeneeded=()=>r.result.createObjectStore("songs",{keyPath:"id"});r.onsuccess=()=>{this.db=r.result;ok(r.result)};r.onerror=()=>no(r.error)}catch(e){no(e)}})},
  tx(mode,fn){return this.open().then(db=>new Promise((ok,no)=>{const t=db.transaction("songs",mode),rq=fn(t.objectStore("songs"));t.oncomplete=()=>ok(rq&&rq.result);t.onerror=t.onabort=()=>no(t.error)}))},
  all(){return this.tx("readonly",s=>s.getAll())},put(o){return this.tx("readwrite",s=>s.put(o))},clear(){return this.tx("readwrite",s=>s.clear())},del(id){return this.tx("readwrite",s=>s.delete(id))}};
 function addedN(){return T.length-BUILT}
 const dec8=(enc,b)=>{try{return new TextDecoder(enc===1?(b[0]===254&&b[1]===255?"utf-16be":"utf-16le"):enc===2?"utf-16be":enc===3?"utf-8":"windows-1252").decode(b)}catch(e){return""}};
 const id3txt=d=>d.length<2?"":dec8(d[0],d.subarray(1)).split("\0").map(x=>x.trim()).filter(Boolean).join(", ");
 function id3pic(d,v2){const enc=d[0];let p;if(v2)p=4;else{const z=d.indexOf(0,1);if(z<0)return null;p=z+1}p++;
  if(enc===1||enc===2){while(p+1<d.length&&!(d[p]===0&&d[p+1]===0))p+=2;p+=2}else{while(p<d.length&&d[p]!==0)p++;p++}
  const b=d.subarray(p);if(b.length<100)return null;return new Blob([b],{type:b[0]===255&&b[1]===216?"image/jpeg":b[0]===137&&b[1]===80?"image/png":b[0]===71?"image/gif":"image/jpeg"})}
 const sync4=(a,i)=>((a[i]&127)<<21)|((a[i+1]&127)<<14)|((a[i+2]&127)<<7)|(a[i+3]&127),be32=(a,i)=>((a[i]<<24)|(a[i+1]<<16)|(a[i+2]<<8)|a[i+3])>>>0,le32=(a,i)=>(a[i]|(a[i+1]<<8)|(a[i+2]<<16)|(a[i+3]<<24))>>>0;
 function unsync(u){const o=new Uint8Array(u.length);let n=0;for(let i=0;i<u.length;i++){o[n++]=u[i];if(u[i]===255&&u[i+1]===0)i++}return o.subarray(0,n)}
 // last resort: look for a JPEG / PNG anywhere inside the tag bytes
 function scanPic(u){for(let i=0;i+8<u.length;i++){if(u[i]===255&&u[i+1]===216&&u[i+2]===255)return new Blob([u.subarray(i)],{type:"image/jpeg"});if(u[i]===137&&u[i+1]===80&&u[i+2]===78&&u[i+3]===71){let e=u.length;for(let j=i+8;j+8<u.length;j++)if(u[j]===73&&u[j+1]===69&&u[j+2]===78&&u[j+3]===68){e=j+8;break}return new Blob([u.subarray(i,e)],{type:"image/png"})}}return null}
 async function id3(f,h,o){const ver=h[3],fl=h[5],size=sync4(h,6);let u=new Uint8Array(await f.slice(10,10+Math.min(size,24e6)).arrayBuffer());if(fl&128)u=unsync(u);
  let p=0;if((fl&64)&&ver>=3)p=ver===4?sync4(u,0):be32(u,0)+4;const il=ver===2?3:4,hl=ver===2?6:10;
  while(p+hl<=u.length){const id=String.fromCharCode(...u.subarray(p,p+il));if(!/^[A-Z0-9]+$/.test(id))break;
   const fs=ver===2?(u[p+3]<<16|u[p+4]<<8|u[p+5]):ver===4?sync4(u,p+4):be32(u,p+4);if(!fs||p+hl+fs>u.length)break;
   let d=u.subarray(p+hl,p+hl+fs),skip=false;const g2=ver>=3?u[p+9]:0;
   if(ver===4){if(g2&1)d=d.subarray(4);if(g2&2)d=unsync(d);if(g2&12)skip=true}else if(ver===3&&(g2&192))skip=true;
   if(!skip&&d.length>1){if(id==="TIT2"||id==="TT2")o.title=id3txt(d);else if(id==="TPE1"||id==="TP1")o.artist=id3txt(d);else if(id==="TALB"||id==="TAL")o.album=id3txt(d);else if((id==="APIC"||id==="PIC")&&!o.pic)o.pic=id3pic(d,ver===2)}
   p+=hl+fs}
  o.alt=scanPic(u)}
 async function flac(f,o){const b=new Uint8Array(await f.slice(0,Math.min(f.size,24e6)).arrayBuffer());let p=4;
  while(p+4<=b.length){const last=b[p]&128,t=b[p]&127,len=(b[p+1]<<16)|(b[p+2]<<8)|b[p+3],s=p+4,d=b.subarray(s,s+len);
   if(t===4){let q=4+le32(d,0);const n=le32(d,q);q+=4;const td=new TextDecoder();for(let i=0;i<n&&q+4<=d.length;i++){const l=le32(d,q);q+=4;const c=td.decode(d.subarray(q,q+l));q+=l;const e=c.indexOf("=");if(e>0){const k=c.slice(0,e).toUpperCase(),v=c.slice(e+1);if(k==="TITLE")o.title=v;else if(k==="ARTIST")o.artist=v;else if(k==="ALBUM")o.album=v}}}
   else if(t===6&&!o.pic){let q=4;q+=4+be32(d,q);q+=4+be32(d,q)+16;const il=be32(d,q);q+=4;o.pic=new Blob([d.subarray(q,q+il)],{type:d[q]===137?"image/png":"image/jpeg"})}
   p=s+len;if(last)break}}
 async function mp4(f,o){const b=new Uint8Array(await f.slice(0,Math.min(f.size,60e6)).arrayBuffer()),td=new TextDecoder();
  const item=(p,sz,ty)=>{const s=p+24,e=p+sz;if(e<=s)return;if(ty==="covr"){if(!o.pic)o.pic=new Blob([b.subarray(s,e)],{type:b[s]===137?"image/png":"image/jpeg"})}else{const v=td.decode(b.subarray(s,e));if(ty==="\u00a9nam")o.title=v;else if(ty==="\u00a9ART"||(ty==="aART"&&!o.artist))o.artist=v;else if(ty==="\u00a9alb")o.album=v}};
  const walk=(s,e,il)=>{let p=s;while(p+8<=e){const sz=be32(b,p),ty=String.fromCharCode(b[p+4],b[p+5],b[p+6],b[p+7]);if(sz<8||p+sz>e)break;if(il)item(p,sz,ty);else if(ty==="moov"||ty==="udta")walk(p+8,p+sz,false);else if(ty==="meta")walk(p+12,p+sz,false);else if(ty==="ilst")walk(p+8,p+sz,true);p+=sz}};walk(0,b.length,false)}
 async function readTags(f){const o={};try{const h=new Uint8Array(await f.slice(0,16).arrayBuffer());
   if(h[0]===73&&h[1]===68&&h[2]===51)await id3(f,h,o);else if(h[0]===102&&h[1]===76&&h[2]===97&&h[3]===67)await flac(f,o);else if(String.fromCharCode(h[4],h[5],h[6],h[7])==="ftyp")await mp4(f,o)}catch(e){}return o}
 const loadImg=b=>new Promise(ok=>{const u=URL.createObjectURL(b),im=new Image();im.onload=()=>{URL.revokeObjectURL(u);ok(im)};im.onerror=async()=>{URL.revokeObjectURL(u);try{ok(await createImageBitmap(b))}catch(e){ok(null)}};im.src=u});
 async function coverOf(tags){for(const b of[tags.pic,tags.alt]){if(b){const im=await loadImg(b);if(im&&(im.naturalWidth||im.width)>8)return im}}return null}
 function rngS(seed){let s=(seed>>>0)||1;return()=>{s=(Math.imul(s,1664525)+1013904223)>>>0;return s/4294967296}}
/* illustration covers: 9 different kinds, picked from the song's name so every song looks different */
function drawArt(style,hue,size){const S=600,c=document.createElement("canvas");c.width=c.height=size||600;const x=c.getContext("2d");x.scale(c.width/S,c.width/S);
 const H=(o,s,l,a)=>`hsla(${(hue+o+720)%360},${s}%,${l}%,${a==null?1:a})`,R=rngS(hue*977+style*131+7);
 const bg=(a,b)=>{const g=x.createLinearGradient(0,0,S*.35,S);g.addColorStop(0,a);g.addColorStop(1,b);x.fillStyle=g;x.fillRect(0,0,S,S)};
 const circ=(cx,cy,r,f)=>{x.fillStyle=f;x.beginPath();x.arc(cx,cy,r,0,7);x.fill()};
 const rr=(a,b,w,h,r)=>{x.beginPath();x.moveTo(a+r,b);x.arcTo(a+w,b,a+w,b+h,r);x.arcTo(a+w,b+h,a,b+h,r);x.arcTo(a,b+h,a,b,r);x.arcTo(a,b,a+w,b,r);x.closePath()};
 const stars=n=>{for(let i=0;i<n;i++){x.fillStyle=`rgba(255,255,255,${.3+R()*.6})`;x.beginPath();x.arc(R()*S,R()*S*.62,.8+R()*1.9,0,7);x.fill()}};
 const ridge=(y,amp,col,step)=>{x.fillStyle=col;x.beginPath();x.moveTo(0,S);x.lineTo(0,y);for(let xx=step/2;xx<=S+step;xx+=step)x.lineTo(xx,y-R()*amp);x.lineTo(S,y);x.lineTo(S,S);x.closePath();x.fill()};
 switch(style%14){
 case 0:{ // vinyl record
  bg(H(0,55,24),H(40,60,8));circ(300,300,252,"#0a0a0f");
  for(let r=76;r<246;r+=8){x.strokeStyle=`rgba(255,255,255,${.035+((r/8)%3)*.025})`;x.lineWidth=1.4;x.beginPath();x.arc(300,300,r,0,7);x.stroke()}
  const g=x.createLinearGradient(80,80,520,520);g.addColorStop(0,"rgba(255,255,255,.2)");g.addColorStop(.45,"rgba(255,255,255,0)");g.addColorStop(.55,"rgba(255,255,255,0)");g.addColorStop(1,"rgba(255,255,255,.14)");circ(300,300,252,g);
  circ(300,300,80,H(0,75,56));circ(300,300,80,"rgba(0,0,0,.12)");circ(300,300,11,"#0a0a0f");break}
 case 1:{ // sunset mountains
  bg(H(25,85,62),H(-35,80,78));circ(300,340,115,"rgba(255,255,255,.35)");circ(300,340,82,"rgba(255,255,255,.75)");
  ridge(380,110,H(-10,40,38),70);ridge(450,100,H(0,45,26),55);ridge(520,80,H(10,50,14),45);break}
 case 2:{ // moon & stars
  bg(H(0,55,10),H(25,50,24));stars(70);circ(410,190,92,"#f4efe0");circ(386,170,16,"rgba(0,0,0,.08)");circ(436,214,11,"rgba(0,0,0,.08)");circ(402,226,7,"rgba(0,0,0,.08)");
  circ(410,190,130,"rgba(255,245,220,.08)");
  x.fillStyle=H(0,45,8);x.beginPath();x.moveTo(0,S);x.lineTo(0,470);for(let xx=0;xx<=S;xx+=10)x.lineTo(xx,470+Math.sin(xx/85)*28);x.lineTo(S,S);x.fill();
  for(let i=0;i<5;i++){const tx=60+i*110+R()*30,ty=480+Math.sin(tx/85)*28;x.fillStyle=H(0,45,5);x.beginPath();x.moveTo(tx,ty-70-R()*30);x.lineTo(tx-24,ty);x.lineTo(tx+24,ty);x.fill()}break}
 case 3:{ // ocean waves
  bg(H(0,75,72),H(30,75,52));circ(300,250,86,"rgba(255,255,255,.8)");
  for(let k=0;k<6;k++){const y=320+k*50;x.fillStyle=H(10+k*8,70,48-k*6,.95);x.beginPath();x.moveTo(0,S);for(let xx=0;xx<=S;xx+=8)x.lineTo(xx,y+Math.sin(xx/55+k*1.7)*(14+k*2));x.lineTo(S,S);x.fill()}break}
 case 4:{ // city skyline
  bg(H(0,60,20),H(45,70,52));circ(160,180,54,"rgba(255,255,240,.9)");stars(30);
  let bx=-10;while(bx<S){const w=44+R()*40,h=120+R()*250;x.fillStyle=H(0,35,8+R()*8);x.fillRect(bx,S-h,w,h);
