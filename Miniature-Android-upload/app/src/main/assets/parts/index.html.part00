$("#dback").onclick=()=>{sub=null;renderList()};
function ask(title,o={}){return new Promise(res=>{const d=$("#dlg"),i=$("#di"),txt=o.value!=null;$("#dt").textContent=title;i.hidden=!txt;i.value=o.value||"";i.inputMode=o.num?"numeric":"text";i.maxLength=o.max||30;$("#dok").textContent=o.ok||"OK";$("#dok").classList.toggle("danger",!!o.danger);d.hidden=false;if(txt)setTimeout(()=>{i.focus();i.select()},60);
 const done=v=>{d.hidden=true;$("#dok").onclick=$("#dc").onclick=d.onclick=i.onkeydown=null;res(v)};
 $("#dok").onclick=()=>done(txt?i.value.trim():true);$("#dc").onclick=()=>done(null);d.onclick=e=>{if(e.target===d)done(null)};i.onkeydown=e=>{if(e.key==="Enter")$("#dok").click();else if(e.key==="Escape")done(null)}})}
function renderPk(){const p=curPl();$("#pk-list").innerHTML=T.map((_,i)=>`<div class="row" data-pk="${i}"><img src="${T[i].img}" alt=""><div class="mt"><b>${esc(T[i].title)}</b><span>${esc(T[i].artist)}</span></div><span class="chk${p.s.includes(i)?" on":""}">${p.s.includes(i)?svg(IC.check):""}</span></div>`).join("")}
$("#padd").onclick=()=>{renderPk();$("#pk").classList.add("open")};
$("#pkx").onclick=()=>{$("#pk").classList.remove("open");renderList()};
$("#pren").onclick=()=>{const p=curPl();ask("Rename playlist",{value:p.name,ok:"Save"}).then(n=>{if(n){p.name=n.slice(0,30);savePls();renderList()}})};
