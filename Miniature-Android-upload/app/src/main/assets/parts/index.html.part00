const MODES=[["Normal",'<path d="M3 7h13M3 12h13M3 17h9"/><path d="M17 14l4 3-4 3"/>'],["Loop",'<path d="M17 2l4 4-4 4"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/>'],["Shuffle",'<path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>']];
