 renderList();paintFav();store.set("now",ST.now);
 if("mediaSession"in navigator)navigator.mediaSession.metadata=new MediaMetadata({title:t.title,artist:t.artist,album:"Miniature",artwork:[{src:t.img,sizes:"128x128",type:"image/jpeg"}]})}
const toggle=()=>{buzz();setPlay(!ST.playing)};
$("#pp").onclick=toggle;$("#prev").onclick=()=>go(-1);$("#next").onclick=()=>go(1);
const toggleFav=i=>{favs.has(i)?favs.delete(i):favs.add(i);store.set("favs",[...favs]);buzz();renderList();paintFav()};
$("#npfav").onclick=()=>toggleFav(ST.now);
app.addEventListener("click",e=>{const g=s=>e.target.closest(s);
 if(g(".rp")){toggle();return}
  if(g("[data-addsongs]")){pickFiles();return}
 const pk=g("[data-pk]");if(pk){const p=curPl(),i=+pk.dataset.pk,x=p.s.indexOf(i);x<0?p.s.push(i):p.s.splice(x,1);savePls();renderPk();return}
 if(g("[data-newpl]")){ask("New playlist",{value:"My playlist",ok:"Create"}).then(n=>{if(n){pls.push({id:Date.now().toString(36),name:n.slice(0,30),s:[]});savePls();renderList()}});return}
