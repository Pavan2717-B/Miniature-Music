if("mediaSession"in navigator){const ms=(a,f)=>{try{navigator.mediaSession.setActionHandler(a,f)}catch(e){}};ms("play",()=>setPlay(true));ms("pause",()=>setPlay(false));ms("previoustrack",()=>go(-1));ms("nexttrack",()=>go(1));ms("seekto",d=>seekTo(d.seekTime))}
