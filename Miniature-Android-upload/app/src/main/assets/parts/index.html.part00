 // auto-enhance: stretch the tonal range a little, lift colour, then a gentle unsharp mask (more for small, upscaled covers)
 function enhance(c,amt){const x=c.getContext("2d"),w=c.width,h=c.height,im=x.getImageData(0,0,w,h),d=im.data,hist=new Uint32Array(256),n=w*h;
  for(let i=0;i<d.length;i+=4)hist[(d[i]*.299+d[i+1]*.587+d[i+2]*.114)|0]++;
  let a=0,lo=0,hi=255;for(let v=0;v<256;v++){a+=hist[v];if(a>=n*.01){lo=v;break}}a=0;for(let v=255;v>=0;v--){a+=hist[v];if(a>=n*.01){hi=v;break}}
  const g=Math.min(1.3,255/Math.max(60,hi-lo)),l0=Math.min(lo,45);
  for(let i=0;i<d.length;i+=4){let r=(d[i]-l0)*g,gg=(d[i+1]-l0)*g,b=(d[i+2]-l0)*g;const l=r*.299+gg*.587+b*.114;d[i]=l+(r-l)*1.12;d[i+1]=l+(gg-l)*1.12;d[i+2]=l+(b-l)*1.12}
  x.putImageData(im,0,0);
  const t=document.createElement("canvas");t.width=w;t.height=h;const tx=t.getContext("2d");tx.filter="blur(1.6px)";if(tx.filter!=="blur(1.6px)")return;tx.drawImage(c,0,0);
  const bd=tx.getImageData(0,0,w,h).data,im2=x.getImageData(0,0,w,h),e=im2.data;for(let i=0;i<e.length;i+=4)for(let k=0;k<3;k++)e[i+k]=e[i+k]+amt*(e[i+k]-bd[i+k]);x.putImageData(im2,0,0)}
 // any shape of cover -> 400x400 square thumbnail + 3:4-ish hero. Portrait art is cropped to fill it; square / wide art is shown whole,
 // edge to edge at the top, and melts into its own blurred colours below (so nothing important is cut off).
 function makeArt(src){const w=src.naturalWidth||src.width,h=src.naturalHeight||src.height,r=w/h,mx=Math.max(w,h),k0=mx>1400?1400/mx:mx<700?Math.min(2.2,900/mx):1,fw=Math.max(2,Math.round(w*k0)),fh=Math.max(2,Math.round(h*k0)),
   full=document.createElement("canvas");full.width=fw;full.height=fh;let x=full.getContext("2d");x.imageSmoothingQuality="high";x.drawImage(src,0,0,fw,fh);enhance(full,mx<700?.8:.4);
  const m=Math.min(fw,fh),sq=document.createElement("canvas");sq.width=sq.height=400;x=sq.getContext("2d");x.imageSmoothingQuality="high";
   if(r>1.12){const sm=document.createElement("canvas");sm.width=sm.height=20;const sx=sm.getContext("2d");sx.imageSmoothingQuality="high";sx.drawImage(full,(fw-m)/2,0,m,m,0,0,20,20);
    x.drawImage(sm,0,0,400,400);x.fillStyle="#0004";x.fillRect(0,0,400,400);const s2=400/fw;x.drawImage(full,0,(400-fh*s2)/2,400,fh*s2)}
   else x.drawImage(full,(fw-m)/2,(fh-m)*(r<1?.25:.5),m,m,0,0,400,400);
  const HW=1080,HH=1725,hr=document.createElement("canvas");hr.width=HW;hr.height=HH;x=hr.getContext("2d");x.imageSmoothingQuality="high";const s=Math.max(HW/fw,HH/fh);
  if(r<.8){x.drawImage(full,(HW-fw*s)/2,(HH-fh*s)*.2,fw*s,fh*s)}
  else{const sb=s*1.15;try{x.filter="blur(48px)"}catch(e){}x.drawImage(full,(HW-fw*sb)/2,(HH-fh*sb)/2,fw*sb,fh*sb);x.filter="none";x.fillStyle="#0006";x.fillRect(0,0,HW,HH);
   const dh=Math.round(HW*fh/fw),tc=document.createElement("canvas");tc.width=HW;tc.height=dh;const t2=tc.getContext("2d");t2.imageSmoothingQuality="high";t2.drawImage(full,0,0,HW,dh);
   const g=t2.createLinearGradient(0,dh*.8,0,dh);g.addColorStop(0,"#000f");g.addColorStop(1,"#0000");t2.globalCompositeOperation="destination-in";t2.fillStyle=g;t2.fillRect(0,0,HW,dh);x.drawImage(tc,0,0)}
  const t=document.createElement("canvas");t.width=t.height=1;const tx=t.getContext("2d");tx.drawImage(full,0,0,1,1);const d=tx.getImageData(0,0,1,1).data;
  return{img:sq.toDataURL("image/jpeg",.9),hero:hr.toDataURL("image/jpeg",.88),avg:[d[0],d[1],d[2]]}}
 const hx=c=>"#"+c.map(v=>Math.round(clamp(v,0,255)).toString(16).padStart(2,"0")).join("");
 async function analyse(f){let dur=0,env=null,k=1;try{const buf=await MiniatureAudio.ctx.decodeAudioData(await f.arrayBuffer());dur=buf.duration;
   const c0=buf.getChannelData(0),c1=buf.numberOfChannels>1?buf.getChannelData(1):null,n=c0.length,r=new Float32Array(LIVE);
   for(let b=0;b<LIVE;b++){const s0=Math.floor(b*n/LIVE),e0=Math.floor((b+1)*n/LIVE);let a=0,c=0;for(let i=s0;i<e0;i+=2){const v=c1?(c0[i]+c1[i])*.5:c0[i];a+=v*v;c++}r[b]=Math.sqrt(a/Math.max(1,c))}
   let sum=0,cnt=0;for(const v of r)if(v>.004){sum+=v;cnt++}const m=cnt?sum/cnt:.1;k=Math.max(.5,Math.min(3,.33/(m*.65)));env=Array.from(r,v=>+Math.max(.06,Math.min(.95,v*.33/m)).toFixed(3))}catch(e){}return{dur,env,k}}
 function addTrack(r){const t={title:r.title,artist:r.artist,dur:r.dur,a:r.a,b:r.b,s:r.s,k:r.k||1,img:r.img,hero:r.hero,cover:r.img,uid:r.id,file:r.file,src:r.src,size:r.size,at:r.at,env:r.env,sw:r.sw||0,cov:r.cov||""};t.th=themeFrom(NEUTRAL);T.push(t);const i=T.length-1;ALBUM[i]=r.album||"From files";Q.push(i);if(r.env)ST.liveEnv[i]=Float32Array.from(r.env);
  N=T.length;if(ST.syncN)ST.syncN();extractPalette(t.img).then(p=>{if(p){t.th=themeFrom(p);if(shown===i)paint()}});return i}
 async function addFiles(list,PM,quiet){const files=[...list].filter(f=>/^audio\//.test(f.type)||/\.(mp3|m4a|aac|wav|ogg|oga|opus|flac)$/i.test(f.name));if(!files.length){toast("No audio files picked");return}
  adding=true;const fresh=[];let ok=0,bad=0,dup=0,keep=true;const at=Date.now();
  for(let n=0;n<files.length;n++){const f=files[n],id=f.name+"|"+f.size+"|"+f.lastModified;if(T.some(t=>t.uid===id)){dup++;continue}
   toast("Adding "+(n+1)+" of "+files.length+"…");
   try{const[tags,an]=await Promise.all([readTags(f),analyse(f)]);if(!an.dur){bad++;continue}
    let nm=f.name.replace(/\.[^.]+$/,"").replace(/_+/g," ").trim(),tt=tags.title,ar=tags.artist;if(!tt&&!ar){const mm=nm.match(/^(.+?)\s+-\s+(.+)$/);if(mm){ar=mm[1];nm=mm[2]}}const title=(tt||nm||"Untitled").slice(0,80),artist=(ar||"Unknown artist").slice(0,80);
    let im=await coverOf(tags);const sw=im?Math.min(im.naturalWidth||im.width,im.naturalHeight||im.height):0;if(!im)im=genArt(title+artist);const art=makeArt(im);
    const r={id,at:at+n,title,artist,album:(tags.album||"From files").slice(0,60),dur:an.dur,env:an.env,k:an.k,img:art.img,hero:art.hero,a:hx(mixc(art.avg,[0,0,0],.74)),b:hx(mixc(art.avg,[0,0,0],.2)),s:hx(mixc(art.avg,[255,255,255],.4)),file:f,src:(PM&&PM.get(f))||f.webkitRelativePath||f.name,size:f.size,cov:"",sw};
    addTrack(r);ok++;fresh.push(id);try{await SDB.put(r)}catch(e){keep=false}}catch(e){bad++}}
  adding=false;renderList();renderSettings();
  toast(ok?("Added "+cn(ok,"song")+(keep?"":" (couldn't save for next time)")):dup&&!bad?"Already added":"Couldn't read those files");if(ok&&cfg.netcov&&!quiet&&fresh.length<=8)runPick(fresh)}

  /* ---- automatic cover lookup (title + artist -> official Apple artwork, up to 1400 px) ---- */
  const sleep=ms=>new Promise(r=>setTimeout(r,ms));
  const jsonp=url=>new Promise(ok=>{const cb="itcb"+Math.random().toString(36).slice(2),sc=document.createElement("script");let done=false;const fin=v=>{if(done)return;done=true;try{delete window[cb]}catch(e){window[cb]=undefined}sc.remove();ok(v)};window[cb]=d=>fin(d);sc.onerror=()=>fin(null);sc.src=url+"&callback="+cb;document.head.appendChild(sc);setTimeout(()=>fin(null),12000)});
  const deac=s=>String(s||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"");
  const norm=s=>deac(s).toLowerCase().replace(/&/g," and ").replace(/[^\p{L}\p{N}\s]/gu," ").replace(/\s+/g," ").trim();
  // "Kesariya (From "Brahmastra") [HD] - Official Video" -> "Kesariya"
  const cleanT=s=>{const o=String(s||""),c=o.replace(/\[[^\]]*\]/g," ").replace(/\([^)]*\)/g," ").replace(/\s[-–—|]\s*(?:from|official|lyric|lyrical|video|audio|full|hd|4k|feat|ft|ost|remastered)\b.*$/i," ").replace(/\b(?:official\s+(?:music\s+)?(?:video|audio)|lyrical?\s+video|lyrics?|full\s+(?:video\s+)?song|video\s+song|audio\s+song|hd|4k|320\s*kbps|192\s*kbps|128\s*kbps|mp3)\b/gi," ").replace(/^\s*\d{1,3}\s*[._)-]\s+/,"").replace(/\s+/g," ").trim();return c||o.replace(/[()\[\]]/g," ").replace(/\s+/g," ").trim()};
  const artistsOf=s=>String(s||"").split(/,|;|&|\/|\bfeat\.?|\bft\.?|\bfeaturing\b|\band\b|\bx\b/i).map(a=>a.replace(/\([^)]*\)/g," ").trim()).filter(a=>a&&!/^unknown( artist)?$/i.test(a));
  function artSize(u,n){return String(u).replace(/\d+x\d+(?:bb|-\d+)?(?=\.(?:jpg|jpeg|png|webp)(?:\?.*)?$)/i,n+"x"+n+"bb")}
  function pickList(rs,tq,aq,raw){const q=norm(tq),qw=q.split(" ").filter(Boolean),at=[...new Set(aq.flatMap(a=>norm(a).split(" ")).filter(w=>w.length>2))],known=at.length>0&&!raw,out=[];
   for(const r of rs){if(!r.artworkUrl100)continue;
    const n0=norm(r.trackName),n=norm(cleanT(r.trackName)),ar=norm((r.artistName||"")+" "+(r.collectionArtistName||"")),all=n0+" "+ar+" "+norm(r.collectionName);
    if(/karaoke|tribute|instrumental|8d audio|lullaby|made famous|cover version|originally performed/.test(all)&&!/karaoke|tribute|instrumental|lullaby/.test(q))continue;
    let ts=0;if(n===q||n0===q)ts=3;else if(n&&q&&Math.min(n.length,q.length)>=4&&(n.includes(q)||q.includes(n)))ts=2;
    if(!ts&&qw.length>1){const b=new Set(n.split(" ")),f=qw.filter(w=>b.has(w)).length/qw.length;if(f>=.75)ts=1.5;else if(f>=.5)ts=1}
    const mt=known?at.filter(w=>ar.includes(w)).length:0;
    let tier=0;if(known?(ts>=1.5&&mt>=1):ts>=3)tier=1;else if(ts>=1||(known&&mt>=1&&qw.some(w=>w.length>3&&n.includes(w))))tier=2;
    if(raw&&!tier)tier=2;if(!tier)continue;out.push({r,tier,sc:ts+(known?mt/at.length:0)})}
   out.sort((a,b)=>a.tier-b.tier||b.sc-a.sc);return out}
  function pickBest(rs,tq,aq){const o=pickList(rs,tq,aq).filter(x=>x.tier===1)[0];return o?o.r:null}
  async function viaProxy(u){for(const p of["https://corsproxy.io/?url="+encodeURIComponent(u),"https://api.allorigins.win/raw?url="+encodeURIComponent(u)]){try{const r=await fetch(p);if(r.ok){const d=await r.json();if(d&&Array.isArray(d.results))return d}}catch(e){}}return null}
  async function itunes(term,cc){const u="https://itunes.apple.com/search?media=music&entity=song&limit=25&country="+cc+"&term="+encodeURIComponent(term);let d=await jsonp(u);if(!d||!Array.isArray(d.results)){d=null;try{const r=await fetch(u);if(r.ok)d=await r.json()}catch(e){}}if(!d||!Array.isArray(d.results)){await sleep(800);d=await jsonp(u)}if(!d||!Array.isArray(d.results))d=await viaProxy(u);return d&&Array.isArray(d.results)?d:null}
  // -> [{url,title,artist}] (best first, up to 3) | undefined (Apple could not be reached)
  // -> {url,title,artist} | null (searched, nothing matched) | undefined (Apple could not be reached)
  async function findCovers(title,artist,raw){const tq=raw?String(title).trim():cleanT(title),as=raw?[]:artistsOf(artist);if(!tq)return[];
   const qs=[],add=(t,c)=>{t=t.trim();if(t&&!qs.some(x=>x[0]===t&&x[1]===c))qs.push([t,c])};
   if(raw){add(tq,"IN");add(tq,"US")}else{const a1=as.slice(0,2).join(" ");add(tq+" "+a1,"IN");add(tq+" "+a1,"US");if(as[1])add(tq+" "+as[1],"IN");add(tq,"IN");add(tq,"US")}
   let reached=false;const A=[],B=[],seen=new Set();
   for(const[term,cc]of qs){const d=await itunes(term,cc);if(!d){if(!reached)return undefined;continue}reached=true;
    if(d.results)for(const o of pickList(d.results,tq,as,raw)){const key=o.r.artworkUrl100.replace(/\/\d+x\d+[^\/]*$/,"");if(seen.has(key))continue;seen.add(key);(o.tier===1?A:B).push({url:artSize(o.r.artworkUrl100,1400),title:o.r.trackName,artist:o.r.artistName})}
    if(A.length>=2||(raw&&A.length+B.length>=3))break;await sleep(150)}
   return A.concat(B).slice(0,3)}
  
  async function findCover(title,artist){const r=await findCovers(title,artist);return r===undefined?undefined:(r[0]||null)}
  const netImg=u=>new Promise(ok=>{let d=false;const f=v=>{if(!d){d=true;ok(v)}},im=new Image();im.crossOrigin="anonymous";im.onload=()=>f(im);im.onerror=()=>f(null);im.src=u;setTimeout(()=>f(null),25000)});
  async function netBlobImg(u){try{const r=await fetch(u,{mode:"cors"});if(!r.ok)return null;return await loadImg(await r.blob())}catch(e){return null}}
  // biggest size Apple will give us: 1400 -> 1000 -> 600 px
  async function netPic(u){for(const sz of[1400,1000,600]){const url=artSize(u,sz),im=await getImg(url),w=im&&(im.naturalWidth||im.width);if(w>=300)return{im,w}}return null}
  function applyArt(t,i,art){if(!t.orig&&t.cov!=="net")t.orig={img:t.img,hero:t.hero,a:t.a,b:t.b,s:t.s,sw:t.sw||0};t.img=t.cover=art.img;t.hero=art.hero;t.a=hx(mixc(art.avg,[0,0,0],.74));t.b=hx(mixc(art.avg,[0,0,0],.2));t.s=hx(mixc(art.avg,[255,255,255],.4));extractPalette(t.img).then(pl=>{if(pl){t.th=themeFrom(pl);if(shown===i)paint()}})}
  async function persist(i){const t=T[i];try{await SDB.put({id:t.uid,at:t.at,title:t.title,artist:t.artist,album:ALBUM[i],dur:t.dur,env:t.env,k:t.k,img:t.img,hero:t.hero,a:t.a,b:t.b,s:t.s,file:t.file,src:t.src,size:t.size,cov:t.cov||"",sw:t.sw||0})}catch(e){}}
  async function netCover(i){const t=T[i],r=await findCover(t.title,t.artist);
   if(r===undefined)return{st:"offline"};
   if(!r){t.cov="tried";await persist(i);return{st:"nomatch"}}
   const p=await netPic(r.url);
   if(!p){t.cov="tried";await persist(i);return{st:"imgfail",hit:r}}
   try{const art=makeArt(p.im);applyArt(t,i,art);t.cov="net";t.sw=p.w;await persist(i);renderList();if(shown===i)paint();return{st:"ok",hit:r}}
   catch(e){t.cov="tried";await persist(i);return{st:"imgfail",hit:r}}}
  function covLogHTML(){if(!covlog.length)return"";const IC2={ok:"✓",nomatch:"✗",imgfail:"!",offline:"!"};
   return'<div class="si"><div class="st"><b>Last cover search</b>'+covlog.map(r=>"<span>"+(IC2[r.st]||"•")+" "+esc(r.title)+" — "+(r.st==="ok"?"matched “"+esc(r.hit.title)+"” by "+esc(r.hit.artist):r.st==="nomatch"?"no confident match on Apple (check the song's title / artist tags)":r.st==="imgfail"?"found on Apple but the picture could not be downloaded":"could not reach Apple")+"</span>").join("")+"</div></div>"}
  let netBusy=false,netAgain=false;
  async function runNet(manual){return true;if(netBusy){netAgain=true;return false}netBusy=true;let found=0,netErr=false,total=0;
   try{const idx=[];for(let i=BUILT;i<T.length;i++){const t=T[i];if(t.file&&t.cov!=="net"&&(manual||t.cov!=="tried"))idx.push(i)}
    total=idx.length;covlog.length=0;
    for(let n=0;n<idx.length;n++){toast("Finding covers "+(n+1)+" of "+idx.length+"…");const r=await netCover(idx[n]);covlog.push(Object.assign({title:T[idx[n]].title},r));
     if(r.st==="offline"){netErr=true;break}if(r.st==="ok")found++;await sleep(500)}}
   finally{netBusy=false}
   const bad=covlog.filter(r=>r.st==="nomatch"||r.st==="imgfail").length;
   if(manual||found||netErr)toast(netErr?"Can't reach Apple — check internet":found?"Found "+cn(found,"cover")+(bad?" · "+bad+" not matched":""):total?"No Apple match for "+cn(bad,"song")+" — see Settings":"All covers are already official");
   renderSettings();
   if(netAgain){netAgain=false;return runNet(false)}
   return !netErr}
 let refreshing=false;
 async function refreshCovers(auto){if(refreshing)return;refreshing=true;let n=0;
  for(let i=BUILT;i<T.length;i++){const t=T[i];if(!t.file||t.cov==="net")continue;if(!auto)toast("Updating covers "+(i-BUILT+1)+" of "+addedN()+"…");
   try{const tags=await readTags(t.file);let im=await coverOf(tags);t.sw=im?Math.min(im.naturalWidth||im.width,im.naturalHeight||im.height):0;if(!im)im=genArt((tags.title||t.title)+(tags.artist||t.artist));const art=makeArt(im);
    t.img=t.cover=art.img;t.hero=art.hero;t.a=hx(mixc(art.avg,[0,0,0],.74));t.b=hx(mixc(art.avg,[0,0,0],.2));t.s=hx(mixc(art.avg,[255,255,255],.4));
    if(tags.title)t.title=tags.title.slice(0,80);if(tags.artist)t.artist=tags.artist.slice(0,80);if(tags.album)ALBUM[i]=tags.album.slice(0,60);
    extractPalette(t.img).then(pl=>{if(pl){t.th=themeFrom(pl);if(shown===i)paint()}});
    try{await SDB.put({id:t.uid,at:t.at,title:t.title,artist:t.artist,album:ALBUM[i],dur:t.dur,env:t.env,k:t.k,img:t.img,hero:t.hero,a:t.a,b:t.b,s:t.s,file:t.file,src:t.src,size:t.size,cov:t.cov||"",sw:t.sw||0})}catch(e){}n++}catch(e){}}
  refreshing=false;renderList();if(shown>=0)paint();renderSettings();if(!auto)toast(n?"Covers updated":"Nothing to update")}

  /* ---- manage added songs: select, see the file each came from, delete ---- */
  let adding=false;const mgSel=new Set();
  const srcOf=t=>t.src||(t.file&&(t.file.webkitRelativePath||t.file.name))||"Unknown file";
  const sizeOf=t=>{const b=t.size||(t.file&&t.file.size)||0;return b?(b>=1048576?(b/1048576).toFixed(1)+" MB":Math.max(1,Math.round(b/1024))+" KB"):""};
  const addedIdx=()=>{const a=[];for(let i=BUILT;i<T.length;i++)a.push(i);return a};
  function renderMg(){const ix=addedIdx(),L=$("#mg-list");
   for(const i of [...mgSel])if(i<BUILT||i>=T.length)mgSel.delete(i);
   $("#mgt").textContent="Added songs ("+ix.length+")";
   L.innerHTML=ix.length?ix.map(i=>{const t=T[i],on=mgSel.has(i),d=t.at?new Date(t.at).toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"}):"";
    return`<div class="row mgr" data-mg="${i}"><span class="chk${on?" on":""}">${on?svg(IC.check):""}</span><img src="${t.img}" alt=""><div class="mt"><b>${esc(t.title)}</b><small class="src lnk" data-mgp="${i}">${esc(srcOf(t))}</small><small class="src2">${esc([sizeOf(t),d&&"added "+d].filter(Boolean).join(" · "))}</small></div><button class="mgc" data-mge="${i}" aria-label="Edit song info">${svg(IC.pencil)}</button><button class="mgc" data-mgc="${i}" aria-label="Choose cover">${svg(IC.album)}</button><button class="mgd" data-mgd="${i}" aria-label="Delete song">${svg(IC.trash)}</button></div>`}).join(""):'<p class="empty">No songs added from your files.</p>';
   const n=mgSel.size;$("#mgdel").disabled=!n;$("#mgdel").textContent=n?"Delete ("+n+")":"Delete";$("#mgall").textContent=ix.length&&n===ix.length?"Clear":"Select all";$("#mgall").disabled=!ix.length}
  function openMg(){mgSel.clear();renderMg();$("#mg").classList.add("open")}
  $("#mgx").onclick=()=>$("#mg").classList.remove("open");
  $("#mgall").onclick=()=>{const ix=addedIdx();if(mgSel.size===ix.length)mgSel.clear();else ix.forEach(i=>mgSel.add(i));renderMg()};
  $("#mgdel").onclick=()=>{const n=mgSel.size;if(!n)return;ask("Delete "+cn(n,"song")+"?",{ok:"Delete",danger:true}).then(y=>{if(y)removeSongs([...mgSel])})};
  $("#mg").addEventListener("click",e=>{const g=s=>e.target.closest(s);let x;
   if(x=g("[data-mgp]")){openPath(+x.dataset.mgp);return}
   if(x=g("[data-mge]")){openEd(+x.dataset.mge);return}
   if(x=g("[data-mgc]")){runPick([T[+x.dataset.mgc].uid]);return}
   if(x=g("[data-mgd]")){const i=+x.dataset.mgd;ask('Delete "'+T[i].title+'"?',{ok:"Delete",danger:true}).then(y=>{if(y)removeSongs([i])});return}
   if(x=g("[data-mg]")){const i=+x.dataset.mg;mgSel.has(i)?mgSel.delete(i):mgSel.add(i);renderMg()}});
  const remapA=(a,map)=>{const o=[];map.forEach((m,i)=>{if(m>=0&&a[i]!==undefined)o[m]=a[i]});a.length=0;o.forEach((v,j)=>{a[j]=v})};
  async function removeSongs(list){
   if(netBusy||refreshing||adding){toast("Busy — try again in a moment");return}
   const ids=new Set(list.filter(i=>i>=BUILT&&i<T.length).map(i=>T[i].uid));if(!ids.size)return;
   for(const id of ids){try{await SDB.del(id)}catch(e){}}
   // from here on everything is synchronous, so no frame can run while indexes are being shifted
   const n0=T.length,map=new Array(n0).fill(-1);let n=0,gone=0;
   for(let i=0;i<n0;i++){if(i>=BUILT&&ids.has(T[i].uid))gone++;else map[i]=n++}
   if(!gone)return;
   const mp=i=>map[i]!==undefined?map[i]:-1,nowGone=mp(ST.now)<0;
   if(nowGone)ST.playing=false;
   if(ST.remapAudio)ST.remapAudio(map);
   const keep=T.filter((_,i)=>map[i]>=0);T.length=0;keep.forEach(t=>T.push(t));
   [ALBUM,ST.liveEnv,HL,SME,ROUGH].forEach(a=>remapA(a,map));
   Q=Q.map(mp).filter(i=>i>=0);
   favs=new Set([...favs].map(mp).filter(i=>i>=0));store.set("favs",[...favs]);
   pls.forEach(p=>{p.s=p.s.map(mp).filter(i=>i>=0)});savePls();
   recent=recent.map(mp).filter(i=>i>=0);store.set("recent",recent);
   const np={};Object.keys(stats.plays).forEach(k=>{const m=mp(+k);if(m>=0)np[m]=stats.plays[k]});stats.plays=np;store.set("stats",stats);
   lastCounted=lastCounted>=0?mp(lastCounted):-1;
   const ns=[...mgSel].map(mp).filter(i=>i>=0);mgSel.clear();ns.forEach(i=>mgSel.add(i));
   ST.now=nowGone?0:mp(ST.now);N=T.length;if(ST.syncN)ST.syncN();
   if(nowGone){ST.elapsed=0;store.set("pos",null)}
   paintPlay();paint();renderSettings();renderMg();
   if(!addedIdx().length)$("#mg").classList.remove("open");
   toast("Deleted "+cn(gone,"song"))}

  /* ---- cover chooser: Apple Music, Deezer, Spotify and JioSaavn previews side by side, the user picks one ---- */
  function CS(){return Object.assign({sid:"",ssec:"",jurl:""},store.get("cs",{}))}
  let spTok=null,cpQ=[],cpI=0,cpSel=null,cpR={},cpTok=0,appleP=null,cpQuery="";
  function appleAll(t){return appleP||(appleP=cpQuery?findCovers(cpQuery,"",true):findCovers(t.title,t.artist))}
  const srcAppleN=n=>async t=>{const r=await appleAll(t);if(r===undefined)return{st:"offline"};const c=r[n];if(!c)return{st:"none"};return{st:"ok",full:c.url,prev:artSize(c.url,500),name:c.title+" — "+c.artist}};
  async function spToken(c){if(spTok&&spTok.exp>Date.now())return spTok.v;const r=await fetch("https://accounts.spotify.com/api/token",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded",Authorization:"Basic "+btoa(c.sid+":"+c.ssec)},body:"grant_type=client_credentials"});if(!r.ok)throw new Error("auth");const d=await r.json();spTok={v:d.access_token,exp:Date.now()+(d.expires_in-60)*1000};return spTok.v}
  async function srcSpotify(t){const c=CS();if(!c.sid||!c.ssec)return{st:"nokey"};
   try{const tk=await spToken(c),a1=artistsOf(t.artist)[0]||"",q="track:"+cleanT(t.title)+(a1?" artist:"+a1:"");
    let r=await fetch("https://api.spotify.com/v1/search?type=track&limit=5&q="+encodeURIComponent(q),{headers:{Authorization:"Bearer "+tk}});
    if(r.status===401){spTok=null;return{st:"badkey"}}if(!r.ok)return{st:"offline"};
    let it=((await r.json()).tracks||{}).items||[];
    if(!it.length){r=await fetch("https://api.spotify.com/v1/search?type=track&limit=5&q="+encodeURIComponent(cleanT(t.title)+" "+a1),{headers:{Authorization:"Bearer "+tk}});if(r.ok)it=((await r.json()).tracks||{}).items||[]}
    const h=it.find(x=>x.album&&x.album.images&&x.album.images.length);if(!h)return{st:"none"};const im=h.album.images;
    return{st:"ok",full:im[0].url,prev:(im[1]||im[0]).url,name:h.name+" — "+h.artists.map(a=>a.name).join(", ")}}
   catch(e){return{st:e&&e.message==="auth"?"badkey":"offline"}}}
  async function srcSaavn(t){const c=CS(),q=(cleanT(t.title)+" "+(artistsOf(t.artist)[0]||"")).trim(),enc=encodeURIComponent(q),urls=[];
   if(c.jurl)urls.push(c.jurl.replace(/\/+$/,"")+"/api/search/songs?query="+enc);
   urls.push("https://www.jiosaavn.com/api.php?__call=search.getResults&_format=json&_marker=0&api_version=4&ctx=web6dot0&n=8&p=1&q="+enc);
   const tn=norm(cleanT(t.title));let reached=false;
   for(const u of urls){try{const r=await fetch(u,{mode:"cors"});if(!r.ok)continue;const d=await r.json();reached=true;
     const L=(d.data&&(d.data.results||d.data))||d.results||(Array.isArray(d)?d:[]);if(!Array.isArray(L))continue;
     const pick=L.filter(x=>x&&x.image).sort((a,b)=>(norm(cleanT(b.name||b.title||"")).includes(tn)?1:0)-(norm(cleanT(a.name||a.title||"")).includes(tn)?1:0))[0];if(!pick)continue;
     let im=pick.image;if(Array.isArray(im)){const l=im[im.length-1]||{};im=l.url||l.link}if(!im)continue;
     const full=String(im).replace(/(\d+x\d+)(?=\.\w+(\?|$))/,"500x500").replace(/^http:/,"https:");
     const ar=pick.primaryArtists||pick.subtitle||(pick.more_info&&pick.more_info.music)||"";
     return{st:"ok",full,prev:full,name:String(pick.name||pick.title||"").replace(/&quot;/g,'"').replace(/&amp;/g,"&")+(ar?" — "+String(ar).replace(/&amp;/g,"&"):"")}}catch(e){}}
   return{st:reached?"none":"offline"}}
  async function srcDeezer(t){const a1=artistsOf(t.artist)[0]||"",ct=cleanT(t.title),tn=norm(ct);let reached=false;
   for(const q of[a1?'track:"'+ct+'" artist:"'+a1+'"':'track:"'+ct+'"',(ct+" "+a1).trim()]){
    const d=await jsonp("https://api.deezer.com/search?limit=8&output=jsonp&q="+encodeURIComponent(q));if(!d||!Array.isArray(d.data))continue;reached=true;
    const L=d.data.filter(x=>x&&x.album&&(x.album.cover_xl||x.album.cover_big)).sort((a,b)=>(norm(cleanT(b.title||"")).includes(tn)?1:0)-(norm(cleanT(a.title||"")).includes(tn)?1:0));const h=L[0];if(!h)continue;
    const full=h.album.cover_xl||h.album.cover_big;return{st:"ok",full,prev:h.album.cover_big||full,name:(h.title||"")+" — "+((h.artist&&h.artist.name)||"")}}
   return{st:reached?"none":"offline"}}
  const CSRC=[["apple","Apple Music",srcAppleN(0)],["apple1","Apple Music · other match",srcAppleN(1)],["apple2","Apple Music · other match",srcAppleN(2)],["deezer","Deezer",srcDeezer],["spotify","Spotify",srcSpotify],["saavn","JioSaavn",srcSaavn]];
  const cpIdx=()=>T.findIndex(x=>x.uid===cpQ[cpI]);
  function cpDraw(){const t=T[cpIdx()];if(!t)return;const msg={none:"No match found · tap to retry",offline:"Couldn't reach it · tap to retry",nokey:"Add your Spotify keys in Settings",badkey:"Spotify keys not accepted"};
   $("#cp-g").innerHTML=`<div class="cpc cur"><div class="cpi"><img src="${t.img}" alt=""></div><b>Current</b><small>${t.cov==="net"?"Online cover":"Original cover"}</small></div>`+CSRC.map(([k,l])=>{const r=cpR[k];if(k.length>5&&k.startsWith("apple")&&(!r||r.st!=="ok"))return"";
    return`<div class="cpc${cpSel===k?" on":""}" data-cp="${k}"><div class="cpi">${!r?"<em>Searching…</em>":r.st==="ok"?`<img src="${esc(r.prev)}" alt="">`:`<em>${msg[r.st]||"Not available"}</em>`}</div><b>${l}</b><small>${r&&r.st==="ok"?esc(r.name||""):""}</small></div>`}).join("");
   $("#cpuse").disabled=!cpSel}
  function cpShow(){while(cpI<cpQ.length&&cpIdx()<0)cpI++;
   if(cpI>=cpQ.length){$("#cp").classList.remove("open");return}
   const t=T[cpIdx()],tok=++cpTok;cpSel=null;cpR={};appleP=null;cpQuery="";
   $("#cpt").textContent=t.title;$("#cpn").textContent=(cpQ.length>1?"Song "+(cpI+1)+" of "+cpQ.length+" · ":"")+"Tap the cover you like, then press Use selected.";
   cpDraw();$("#cp").classList.add("open");
   CSRC.forEach(([k,,fn])=>{fn(t).catch(()=>({st:"offline"})).then(r=>{if(tok!==cpTok)return;cpR[k]=r;cpDraw()})})}
  $("#cp-g").onclick=e=>{const c=e.target.closest("[data-cp]");if(!c)return;const k0=c.dataset.cp,r=cpR[k0];
   if(r&&(r.st==="offline"||r.st==="none")){const src=CSRC.find(x=>x[0]===k0),t=T[cpIdx()],tok=cpTok;if(!src||!t)return;if(k0.startsWith("apple"))appleP=null;delete cpR[k0];cpDraw();src[2](t).catch(()=>({st:"offline"})).then(v=>{if(tok!==cpTok)return;cpR[k0]=v;cpDraw()});return}
   if(!r||r.st!=="ok")return;cpSel=c.dataset.cp;cpDraw()};
  $("#cpskip").onclick=()=>{cpI++;cpShow()};
  $("#cpx").onclick=()=>{cpTok++;$("#cp").classList.remove("open")};
  $("#cpuse").onclick=async()=>{const r=cpR[cpSel],i=cpIdx();if(!r||i<0)return;const t=T[i];$("#cpuse").disabled=true;toast("Applying cover…");
   const im=await getImg(r.full)||(r.prev!==r.full?await getImg(r.prev):null);
   if(!im){toast("This source blocks the download — pick another cover");cpDraw();return}
   try{const art=makeArt(im);applyArt(t,i,art);t.cov="net";t.sw=im.naturalWidth||im.width;await persist(i);renderList();if(shown===i)paint();renderSettings()}catch(e){toast("Couldn't use that picture");cpDraw();return}
   cpI++;cpShow()};
  /* ---- Edit song: title, artist, trim and cover. The MP3 file itself is rewritten (new ID3 tag + cut frames) ---- */
  let edI=-1,edBuf=null,edInfo=null,edS=0,edE=0,edPic=null,edBusy=false,edUrl=null,edTok=0,edL=[];
  const edSync4=(b,o)=>((b[o]&127)<<21)|((b[o+1]&127)<<14)|((b[o+2]&127)<<7)|(b[o+3]&127);
  const edBe32=(b,o)=>((b[o]<<24)|(b[o+1]<<16)|(b[o+2]<<8)|b[o+3])>>>0;
  const edFt=s=>fmt(s)+"."+Math.floor((s%1)*10);
  const u16=s=>{const o=new Uint8Array(s.length*2);for(let i=0;i<s.length;i++){const c=s.charCodeAt(i);o[2*i]=c&255;o[2*i+1]=c>>8}return o};
  const cat=a=>{let n=0;for(const x of a)n+=x.length;const o=new Uint8Array(n);let p=0;for(const x of a){o.set(x,p);p+=x.length}return o};
  const asc=s=>Uint8Array.from(s,c=>c.charCodeAt(0));
  const BOM=Uint8Array.of(255,254),Z2=Uint8Array.of(0,0);
  const frm=(id,d)=>{const h=new Uint8Array(10);h.set(asc(id));h[4]=d.length>>>24;h[5]=(d.length>>16)&255;h[6]=(d.length>>8)&255;h[7]=d.length&255;return cat([h,d])};
  const txf=(id,parts)=>frm(id,cat([Uint8Array.of(1),...parts.flatMap(s=>[BOM,u16(s),Z2])]));
  // read the frame list of an MP3 (Layer III): [{o:offset,l:length,h:header}] + sample rate, samples/frame, duration
  function mp3Parse(u){
   let p=0;if(u[0]===73&&u[1]===68&&u[2]===51)p=10+edSync4(u,6)+((u[5]&16)?10:0);
   const BR=[[0,32,40,48,56,64,80,96,112,128,160,192,224,256,320],[0,8,16,24,32,40,48,56,64,80,96,112,128,144,160]],SRT={3:[44100,48000,32000],2:[22050,24000,16000],0:[11025,12000,8000]};
   const hd=q=>{if(q+4>u.length||u[q]!==255||(u[q+1]&224)!==224)return null;const ver=(u[q+1]>>3)&3,lay=(u[q+1]>>1)&3;if(ver===1||lay!==1)return null;
    const bi=u[q+2]>>4,si=(u[q+2]>>2)&3;if(bi===0||bi===15||si===3)return null;const v1=ver===3,sr=SRT[ver][si],br=BR[v1?0:1][bi]*1000,pad=(u[q+2]>>1)&1;
    return{v1,sr,br,len:Math.floor((v1?144:72)*br/sr)+pad,spf:v1?1152:576,mono:(u[q+3]>>6)===3,prot:!(u[q+1]&1)}};
   let h=null;for(const lim=Math.min(u.length-4,p+65536);p<lim;p++){h=hd(p);if(h&&(hd(p+h.len)||p+h.len>=u.length-128))break;h=null}
   if(!h)return null;
   const fr=[],sr=h.sr,spf=h.spf,br0=h.br;let first=true,cbr=true;
   while(p+4<=u.length){if(u[p]===84&&u[p+1]===65&&u[p+2]===71&&p>=u.length-128)break;
    let f=hd(p);if(!f||f.sr!==sr||p+f.len>u.length){let q=p+1,ok=false;for(const lim=Math.min(u.length-4,p+4096);q<lim;q++){const g=hd(q);if(g&&g.sr===sr&&q+g.len<=u.length&&(hd(q+g.len)||q+g.len>=u.length-128)){ok=true;break}}if(!ok)break;p=q;f=hd(p)}
    if(first){first=false;const off=4+(f.prot?2:0)+(f.v1?(f.mono?17:32):(f.mono?9:17)),tg=String.fromCharCode(u[p+off]||0,u[p+off+1]||0,u[p+off+2]||0,u[p+off+3]||0),vb=String.fromCharCode(u[p+36]||0,u[p+37]||0,u[p+38]||0,u[p+39]||0);
     if(tg==="Xing"||tg==="Info"||vb==="VBRI"){p+=f.len;continue}}
    fr.push({o:p,l:f.len,h:f});if(f.br!==br0)cbr=false;p+=f.len}
   return fr.length<10?null:{fr,sr,spf,cbr,dur:fr.length*spf/sr}}
  // new ID3v2.3 tag: edited title/artist (+ new cover) and every other frame of the old tag that can be kept
  function id3Build(u,o){
   const out=[txf("TIT2",[o.title]),txf("TPE1",[o.artist])];
   if(o.jpg)out.push(frm("APIC",cat([Uint8Array.of(0),asc(o.mime),Uint8Array.of(0,3,0),o.jpg])));
   if(u[0]===73&&u[1]===68&&u[2]===51&&(u[3]===3||u[3]===4)&&!(u[5]&128)){const v4=u[3]===4,end=10+edSync4(u,6);let p=10;
    if(u[5]&64)p=v4?10+edSync4(u,10):14+edBe32(u,10);
    const dec=(e,b)=>new TextDecoder(e===3?"utf-8":"utf-16be").decode(b);
    while(p+10<=end&&u[p]){const id=String.fromCharCode(u[p],u[p+1],u[p+2],u[p+3]),sz=v4?edSync4(u,p+4):edBe32(u,p+4),f2=u[p+9];
     if(sz<=0||p+10+sz>end||!/^[A-Z0-9]{4}$/.test(id))break;
     let d=u.subarray(p+10,p+10+sz);p+=10+sz;
     if(v4?(f2&0x4F):(f2&0xE0))continue;                       // compressed / encrypted / unsynchronised frames are not kept
     if(id==="TIT2"||id==="TPE1"||id==="TLEN"||id==="TSIZ"||(id==="APIC"&&o.jpg))continue;
     if(v4&&(d[0]===2||d[0]===3)){const e=d[0];
      if(id[0]==="T"){out.push(txf(id,dec(e,d.subarray(1)).replace(/\0+$/,"").split("\0")));continue}
      if(id==="COMM"||id==="USLT"){const s=dec(e,d.subarray(4)),z=s.indexOf("\0"),ds=z<0?"":s.slice(0,z),tx=(z<0?s:s.slice(z+1)).replace(/\0+$/,"");out.push(frm(id,cat([Uint8Array.of(1),d.subarray(1,4),BOM,u16(ds),Z2,BOM,u16(tx),Z2])));continue}
      if(id==="APIC"){d=d.slice();d[0]=0}}
     out.push(frm(id,d))}}
   const body=cat(out),n=body.length;return cat([Uint8Array.of(73,68,51,3,0,0,(n>>21)&127,(n>>14)&127,(n>>7)&127,n&127),body])}
  function buildMp3(u,info,o){
   const f0=Math.max(0,Math.floor(o.start*info.sr/info.spf)),f1=Math.min(info.fr.length,Math.ceil(o.end*info.sr/info.spf)),sel=info.fr.slice(f0,Math.max(f0+1,f1)),h0=sel[0].h;
   const xl=sel[0].l,x=new Uint8Array(xl);x.set(u.subarray(sel[0].o,sel[0].o+4));x[1]|=1;      // Xing/Info header frame so players show the right length
   const off=4+(h0.v1?(h0.mono?17:32):(h0.mono?9:17)),by=sel.reduce((a,f)=>a+f.l,xl),nf=sel.length;
   x.set(asc(info.cbr?"Info":"Xing"),off);x.set([0,0,0,3,nf>>>24,(nf>>16)&255,(nf>>8)&255,nf&255,by>>>24,(by>>16)&255,(by>>8)&255,by&255],off+4);
   return cat([id3Build(u,o),x,...sel.map(f=>u.subarray(f.o,f.o+f.l))])}
  async function edJpeg(im){const w=im.naturalWidth||im.width,h=im.naturalHeight||im.height,k=Math.min(1,1000/Math.max(w,h)),c=document.createElement("canvas");c.width=Math.max(1,Math.round(w*k));c.height=Math.max(1,Math.round(h*k));const g=c.getContext("2d");g.fillStyle="#000";g.fillRect(0,0,c.width,c.height);g.drawImage(im,0,0,c.width,c.height);const b=await new Promise(r=>c.toBlob(r,"image/jpeg",.9));return b?new Uint8Array(await b.arrayBuffer()):null}
  async function saveToDevice(f){const nm=f.name||"song.mp3";
   try{if(window.showSaveFilePicker){const h=await showSaveFilePicker({suggestedName:nm,types:[{description:"MP3 audio",accept:{"audio/mpeg":[".mp3"]}}]});const w=await h.createWritable();await w.write(f);await w.close();return"saved"}}catch(e){if(e&&e.name==="AbortError")return"cancel"}
   const u=URL.createObjectURL(f),a=document.createElement("a");a.href=u;a.download=nm;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),60000);return"download"}
  const edSl=()=>{const d=edInfo?edInfo.dur:1;$("#edss").textContent=edFt(edS);$("#edes").textContent=edFt(edE);$("#edl2").textContent="New length "+fmt(edE-edS);$("#edrs").style.setProperty("--p",(edS/d*100)+"%");$("#edre").style.setProperty("--p",(edE/d*100)+"%")};
  async function openEd(i){const t=T[i];if(!t)return;if(i<BUILT){toast("Built-in songs can't be edited — add your own MP3s");return}
   edI=i;edPic=null;edInfo=null;edBuf=null;edTok++;if(edUrl){URL.revokeObjectURL(edUrl);edUrl=null}
   $("#edt").value=t.title;$("#eda").value=/^unknown artist$/i.test(t.artist)?"":t.artist;$("#edimg").src=t.img;$("#edres").innerHTML="";$("#edtr").hidden=true;$("#edsave").disabled=false;
   $("#ednote").textContent="Reading the file…";$("#ed").classList.add("open");
   try{if(t.file){const u=new Uint8Array(await t.file.arrayBuffer());if(edI!==i)return;edBuf=u;edInfo=mp3Parse(u)}}catch(e){}
   if(edI!==i)return;
   if(edInfo){edS=0;edE=edInfo.dur;const rs=$("#edrs"),re=$("#edre");rs.max=re.max=edInfo.dur.toFixed(2);rs.value=0;re.value=edInfo.dur.toFixed(2);edSl();$("#edtr").hidden=edInfo.dur<3;
    $("#ednote").textContent="Saving writes the new title, artist, cover and trim into the MP3 file itself."}
   else $("#ednote").textContent="This file type can't be rewritten, so title, artist and cover change inside Miniature only (trimming needs an MP3)."}
  async function edSave(){if(edBusy||edI<0)return;const i=edI,t=T[i];if(!t)return;
   const title=$("#edt").value.trim().slice(0,120),ar=$("#eda").value.trim().slice(0,120)||"Unknown artist";
   if(!title){toast("The title can't be empty");return}
   const trim=!!edInfo&&(edS>.05||edE<edInfo.dur-.05);
   if(title===t.title&&ar===t.artist&&!edPic&&!trim){$("#ed").classList.remove("open");toast("No changes");return}
   edBusy=true;$("#edsave").disabled=true;toast("Saving…");
   try{let file=t.file,jpg=null;
    if(edInfo&&edBuf){
     if(edPic)jpg=await edJpeg(edPic.im);else if(t.cov==="net"){try{jpg=new Uint8Array(await(await fetch(t.img)).arrayBuffer())}catch(e){}}
     let nm=(t.file&&t.file.name)||String(srcOf(t)).split(/[\\/]/).pop()||"song.mp3";if(!/\.[A-Za-z0-9]{2,4}$/.test(nm))nm+=".mp3";
     const bytes=buildMp3(edBuf,edInfo,{title,artist:ar,jpg,mime:jpg&&jpg[0]===137?"image/png":"image/jpeg",start:trim?edS:0,end:trim?edE:edInfo.dur});
     file=new File([bytes],nm,{type:"audio/mpeg",lastModified:Date.now()})}
    let an=null;if(trim){an=await analyse(file);if(!an.dur)throw new Error("decode")}
    if(edPic){const art=makeArt(edPic.im);applyArt(t,i,art);t.sw=edPic.w;t.cov=jpg?"file":"net"}else if(jpg)t.cov="file";
    t.title=title;t.artist=ar;
    if(file!==t.file){t.file=file;t.size=file.size}
    if(an){t.dur=an.dur;t.env=an.env;t.k=an.k;if(an.env)ST.liveEnv[i]=Float32Array.from(an.env);delete HL[i];delete SME[i];delete ROUGH[i];if(ST.reloadAudio)ST.reloadAudio(i);if(ST.now===i)ST.elapsed=0}
    await persist(i);
    renderList();if(ST.now===i||shown===i)paint();try{paintPlay()}catch(e){}renderSettings();if($("#mg").classList.contains("open"))renderMg();
    $("#ed").classList.remove("open");
    if(edInfo&&$("#edcp").checked){const r=await saveToDevice(file);toast(r==="download"?"Saved. The edited MP3 was also downloaded to your phone (Downloads)":r==="saved"?"Saved. The edited MP3 was written to your phone":"Saved in Miniature — the file was not saved to your phone (use Download file)")}
    else toast(edInfo?"Saved":"Saved in Miniature (this file type can't be rewritten)")
   }catch(e){toast(e&&e.message==="decode"?"Couldn't trim this file":"Couldn't save the changes")}
   edBusy=false;$("#edsave").disabled=false}
  async function edFind(kind){const title=$("#edt").value.trim(),artist=$("#eda").value.trim(),R=$("#edres"),my=++edTok;R.innerHTML="<em>Searching…</em>";let L=[];
   if(kind==="apple"){let r=await findCovers(title,artist);if(r&&!r.length)r=await findCovers((title+" "+artist).trim(),"",true);
    if(my!==edTok)return;if(r===undefined){R.innerHTML="<em>Couldn't reach Apple Music — check your internet</em>";return}
    L=r.map(x=>({full:x.url,prev:artSize(x.url,300),name:x.title+" — "+x.artist}))}
   else{const r=await srcSpotify({title,artist});if(my!==edTok)return;
    if(r.st==="nokey"||r.st==="badkey"){R.innerHTML="<em>Add valid Spotify keys in Settings → Cover sources first</em>";return}
    if(r.st!=="ok"){R.innerHTML="<em>"+(r.st==="none"?"No Spotify match":"Couldn't reach Spotify")+"</em>";return}
    L=[{full:r.full,prev:r.prev,name:r.name}]}
   edL=L;R.innerHTML=L.length?L.map((x,n)=>`<button data-er="${n}" aria-label="${esc(x.name)}"><img src="${esc(x.prev)}" alt=""></button>`).join(""):"<em>No match found — change the title or artist and try again</em>"}
  $("#edres").onclick=async e=>{const b=e.target.closest("[data-er]");if(!b)return;const x=edL[+b.dataset.er];if(!x)return;toast("Loading cover…");
   const im=await getImg(x.full)||(x.prev!==x.full?await getImg(x.prev):null);if(!im){toast("Couldn't download that cover — try another");return}
   edPic={im,w:im.naturalWidth||im.width};$("#edimg").src=x.prev;[...$("#edres").children].forEach(c=>c.classList.toggle("on",c===b));toast("Cover selected — press Save changes")};
  $("#edgal").onchange=async e=>{const f=e.target.files[0];e.target.value="";if(!f)return;const im=await loadImg(f);if(!im){toast("Couldn't read that image");return}
   edPic={im,w:im.naturalWidth||im.width};if(edUrl)URL.revokeObjectURL(edUrl);edUrl=URL.createObjectURL(f);$("#edimg").src=edUrl;$("#edres").innerHTML="";toast("Cover selected — press Save changes")};
  $("#ed").addEventListener("click",e=>{const c=e.target.closest("[data-ec]");if(!c)return;const k=c.dataset.ec;if(k==="gallery")$("#edgal").click();else edFind(k)});
  $("#edrs").oninput=e=>{edS=Math.min(+e.target.value,edE-1);e.target.value=edS;edSl()};
  $("#edre").oninput=e=>{edE=Math.max(+e.target.value,edS+1);e.target.value=edE;edSl()};
  $("#edx").onclick=()=>{edTok++;edI=-1;$("#ed").classList.remove("open")};
  $("#edsave").onclick=edSave;
  $("#eddl").onclick=()=>{const t=T[edI];if(t&&t.file)saveToDevice(t.file.name?t.file:new File([t.file],"song.mp3",{type:"audio/mpeg"})).then(r=>{if(r==="download")toast("Downloaded")})};
  $("#npedit").onclick=()=>openEd(ST.now);
  function runPick(m){const u=Array.isArray(m)?m:addedIdx().map(i=>T[i].uid);if(!u.length){toast("No added songs yet");return}cpQ=u;cpI=0;cpShow()}

  /* ---- image download with fallbacks (some devices block direct downloads) + back to the original cover ---- */
  const prox=u=>"https://wsrv.nl/?url="+encodeURIComponent(String(u).replace(/^https?:\/\//,""))+"&output=jpg&q=92";
  async function getImg(u){return await netImg(u)||await netBlobImg(u)||await netImg(prox(u))||await netBlobImg(prox(u))}
  async function revertCover(i){const t=T[i];let done=false;
   try{if(t.file){const tags=await readTags(t.file);let im=await coverOf(tags);t.sw=im?Math.min(im.naturalWidth||im.width,im.naturalHeight||im.height):0;if(!im)im=genArt((tags.title||t.title)+(tags.artist||t.artist));applyArt(t,i,makeArt(im));done=true}
    else if(t.orig){const o=t.orig;t.img=t.cover=o.img;t.hero=o.hero;t.a=o.a;t.b=o.b;t.s=o.s;t.sw=o.sw||0;extractPalette(t.img).then(pl=>{if(pl){t.th=themeFrom(pl);if(shown===i)paint()}});done=true}}catch(e){}
   if(done){t.cov="";t.orig=null;await persist(i);renderList();if(shown===i)paint();renderSettings()}return done}
  async function regenArt(){for(let i=BUILT;i<T.length;i++){const t=T[i];if(!t.file||t.sw||t.cov==="net")continue;try{const art=makeArt(genArt(t.title+t.artist));applyArt(t,i,art);t.orig=null;await persist(i)}catch(e){}}renderList();if(shown>=0)paint()}
  async function restoreAll(){const ix=T.map((_,i)=>i).filter(i=>T[i].cov==="net"||T[i].orig);if(!ix.length){toast("All covers are already original");return}toast("Restoring covers…");let n=0;for(const i of ix)if(await revertCover(i))n++;toast(n?"Restored "+cn(n,"cover"):"Nothing to restore")}
  $("#cporig").onclick=async()=>{const i=cpIdx();if(i<0)return;const t=T[i];if(t.cov!=="net"&&!t.orig){toast("This song already has its original cover");return}toast("Restoring…");const ok=await revertCover(i);toast(ok?"Back to the original cover":"Couldn't restore it");cpDraw()};
  $("#cpsrch").onclick=()=>{const t=T[cpIdx()];if(!t)return;ask("Search Apple Music for…",{value:cpQuery||(cleanT(t.title)+" "+(artistsOf(t.artist)[0]||"")).trim(),ok:"Search",max:80}).then(v=>{if(!v)return;cpQuery=v;appleP=null;const tok=cpTok;["apple","apple1","apple2"].forEach(k=>{delete cpR[k];if(cpSel===k)cpSel=null});cpDraw();CSRC.filter(c=>c[0].startsWith("apple")).forEach(([k,,fn])=>fn(t).catch(()=>({st:"offline"})).then(r=>{if(tok!==cpTok)return;cpR[k]=r;cpDraw()}))})};

  /* ---- music folders: allow once, songs are found automatically; the path of every song is shown ---- */
  var FOLD=[];
  const isAud=f=>/^audio\//.test(f.type)||/\.(mp3|m4a|aac|wav|ogg|oga|opus|flac)$/i.test(f.name);
  const FDB={db:null,open(){return this.db?Promise.resolve(this.db):new Promise((ok,no)=>{try{const r=indexedDB.open("miniature-folders",1);r.onupgradeneeded=()=>r.result.createObjectStore("h",{keyPath:"id"});r.onsuccess=()=>{this.db=r.result;ok(r.result)};r.onerror=()=>no(r.error)}catch(e){no(e)}})},
   tx(mode,fn){return this.open().then(db=>new Promise((ok,no)=>{const t=db.transaction("h",mode),rq=fn(t.objectStore("h"));t.oncomplete=()=>ok(rq&&rq.result);t.onerror=t.onabort=()=>no(t.error)}))},
   all(){return this.tx("readonly",s=>s.getAll())},put(o){return this.tx("readwrite",s=>s.put(o))},del(id){return this.tx("readwrite",s=>s.delete(id))}};
  function foldHTML(){const F=FOLD||[];
   return item("Music folders",F.length?"Songs in these folders are added automatically when you open the app.":(window.showDirectoryPicker?"Allow a folder such as Music or Download. Miniature finds the MP3s inside and keeps checking it for new ones.":"Pick a folder such as Music or Download. This browser can't keep folder access, so new songs are only found when you pick the folder again."),'<div class="abr">'+btn("addfolder","Allow music folder")+'</div>',1)
    +F.map(f=>item(esc(f.name),esc(f.st||""),'<div class="abr">'+(f.handle?btn("fsc:"+f.id,"Rescan"):"")+btn("fdel:"+f.id,"Remove","danger")+'</div>')).join("")}
  function folderAct(a){
   if(a==="addfolder"){addFolder();return true}
   if(a.startsWith("fsc:")){const f=FOLD.find(x=>x.id===a.slice(4));if(f)scanFolder(f,false);return true}
   if(a.startsWith("fdel:")){const id=a.slice(5);FDB.del(id).catch(()=>{});FOLD=FOLD.filter(x=>x.id!==id);renderSettings();toast("Folder removed — its songs stay in your library");return true}
   return false}
  async function walkDir(d,base,out,depth){for await(const[n,h]of d.entries()){if(h.kind==="directory"){if(depth<8&&n[0]!==".")await walkDir(h,base+"/"+n,out,depth+1)}else if(/\.(mp3|m4a|aac|wav|ogg|oga|opus|flac)$/i.test(n))out.push([h,base+"/"+n])}}
  async function scanFolder(f,quiet){f.st="Scanning…";renderSettings();
   try{const h=f.handle;if(await h.queryPermission({mode:"read"})!=="granted"&&await h.requestPermission({mode:"read"})!=="granted"){f.st="Tap Rescan and allow access";renderSettings();return}
    const found=[];await walkDir(h,f.name,found,0);const have=new Set(T.map(t=>t.uid)),fresh=[],pm=new Map();
    for(const[fh,p]of found){const file=await fh.getFile(),id=file.name+"|"+file.size+"|"+file.lastModified;if(have.has(id))continue;have.add(id);fresh.push(file);pm.set(file,p)}
    f.st=found.length+" songs found · checked "+new Date().toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"});renderSettings();
    if(!fresh.length){if(!quiet)toast("No new songs in "+f.name);return}
    if(fresh.length>30&&!(await ask("Add "+fresh.length+" new songs from "+f.name+"?",{ok:"Add"})))return;
    await addFiles(fresh,pm,quiet)}catch(e){f.st="Couldn't read this folder";renderSettings()}}
  async function addFolder(){
   if(window.showDirectoryPicker){try{const h=await showDirectoryPicker({mode:"read"});
     const ex=FOLD.find(x=>x.name===h.name),f=ex||{id:Date.now().toString(36),name:h.name,handle:h,st:""};f.handle=h;if(!ex)FOLD.push(f);
     try{await FDB.put({id:f.id,name:f.name,handle:h})}catch(e){}
     renderSettings();await scanFolder(f,false)}catch(e){if(e&&e.name!=="AbortError"){const y=await ask("Chrome blocked that folder (it refuses Download, Music or Documents themselves). Try the other folder picker?",{ok:"Try another way"});if(y)pickFolderInput()}}return}
   pickFolderInput()}
  let fi=null;function pickFolderInput(){if(window.AndroidBridge&&AndroidBridge.pickFolder){window.__onFolder=async o=>{const L=o.files||[];if(!L.length){toast("No audio files in that folder");return}
     if(L.length>30&&!(await ask("Add "+L.length+" songs from "+o.name+"?",{ok:"Add"})))return;
     for(let i=0;i<L.length;i+=15){const fs=[];for(const m of L.slice(i,i+15)){try{const bl=await (await fetch(m.url)).blob();fs.push(new File([bl],m.name,{type:m.type,lastModified:m.mod}))}catch(e){}}if(fs.length)await addFiles(fs)}};
    AndroidBridge.pickFolder();return}if(!fi){fi=document.createElement("input");fi.type="file";fi.multiple=true;fi.setAttribute("webkitdirectory","");fi.hidden=true;
    fi.onchange=async()=>{const l=[...fi.files].filter(isAud);fi.value="";if(!l.length){toast("No audio files in that folder");return}
     if(l.length>30&&!(await ask("Add "+l.length+" songs from this folder?",{ok:"Add"})))return;addFiles(l)};document.body.appendChild(fi)}fi.click()}
  function openPath(i){const t=T[i];if(!t)return;const p=srcOf(t),k=p.lastIndexOf("/"),dir=k>0?p.slice(0,k):"";
   try{navigator.clipboard&&navigator.clipboard.writeText(p)}catch(e){}
   if(!dir){toast("Copied: "+p+" — search it in your file manager");return}
   let left=false;const hd=()=>{if(document.hidden)left=true};document.addEventListener("visibilitychange",hd);
   try{location.href="intent://com.android.externalstorage.documents/document/primary%3A"+encodeURIComponent(dir)+"#Intent;scheme=content;action=android.intent.action.VIEW;type=vnd.android.document/directory;end"}catch(e){}
   setTimeout(()=>{document.removeEventListener("visibilitychange",hd);if(!left)toast("Couldn't open it — path copied: "+dir)},1200)}

  /* ---- long-press to select (everything else blurs), swipe left to delete ---- */
  let selMode=false,lpFired=false,lpT=0,lpX=0,lpY=0,sw=null;const selS=new Set();
  function selPaint(){app.classList.toggle("sel",selMode);$("#selbar").hidden=!selMode;if(selMode)$("#selc").textContent=cn(selS.size,"song");
   $$("#list .row[data-i]").forEach(r=>r.classList.toggle("picked",selMode&&selS.has(+r.dataset.i)))}
  function selExit(){selMode=false;selS.clear();$("#mini").classList.remove("mclear");resetSw();selPaint()}
  function selStart(i){selMode=true;selS.clear();selS.add(i);$("#mini").classList.remove("mclear");buzz();selPaint()}
  function selToggle(i){selS.has(i)?selS.delete(i):selS.add(i);if(!selS.size){selExit();return}selPaint()}
  function resetSw(){$$("#list .row").forEach(r=>{r.style.transform="";r.style.background="";r.style.transition=""})}
  async function selDelete(){const all=[...selS],del=all.filter(i=>i>=BUILT);resetSw();
   if(!del.length){toast("Built-in songs can't be deleted");return}
   await removeSongs(del);selExit();if(all.length>del.length)toast("Deleted "+cn(del.length,"song")+" · built-in songs kept")}
  window.__selPaint=selPaint;window.__selExit=selExit;
  const LST=$("#list");
  document.addEventListener("pointerdown",()=>{lpFired=false},true);
  LST.addEventListener("pointerdown",e=>{const r=e.target.closest(".row[data-i]");sw=null;clearTimeout(lpT);if(!r)return;lpX=e.clientX;lpY=e.clientY;
   if(selMode){if(r.classList.contains("picked"))sw={x:e.clientX,y:e.clientY,dx:0,on:false}}
   else lpT=setTimeout(()=>{lpFired=true;selStart(+r.dataset.i)},450)});
  LST.addEventListener("pointermove",e=>{if(Math.hypot(e.clientX-lpX,e.clientY-lpY)>10)clearTimeout(lpT);
   if(!sw)return;const dx=e.clientX-sw.x,dy=e.clientY-sw.y;
   if(!sw.on){if(dx<-14&&Math.abs(dx)>Math.abs(dy)*1.4)sw.on=true;else return}
   sw.dx=Math.min(0,dx);const hot=sw.dx<-90;
   $$("#list .row.picked").forEach(r=>{r.style.transition="none";r.style.transform="translateX("+sw.dx+"px)";r.style.background=hot?"#e5484d66":""})});
  const swEnd=e=>{clearTimeout(lpT);if(!sw)return;const s=sw;sw=null;if(s.on)lpFired=true;if(s.on&&s.dx<-90&&e.type==="pointerup")selDelete();else resetSw()};
  LST.addEventListener("pointerup",swEnd);LST.addEventListener("pointercancel",swEnd);
  LST.addEventListener("contextmenu",e=>e.preventDefault());
  app.addEventListener("click",e=>{
   if(lpFired){lpFired=false;e.stopPropagation();e.preventDefault();return}
   if(!selMode||e.target.closest("#selbar"))return;
   if(e.target.closest(".rp")){$("#mini").classList.add("mclear");return}
   const r=e.target.closest("#list .row[data-i]");
   if(r){e.stopPropagation();selToggle(+r.dataset.i);return}
   if(e.target.closest("#v-songs,#mini"))e.stopPropagation()},true);
  $("#selx").onclick=selExit;
 let fp=null;function pickFiles(){if(!fp){fp=document.createElement("input");fp.type="file";fp.accept="audio/*,.mp3";fp.multiple=true;fp.hidden=true;fp.onchange=()=>{const l=[...fp.files];fp.value="";addFiles(l)};document.body.appendChild(fp)}fp.click()}
 async function clearAdded(){try{await SDB.clear()}catch(e){}
  if(ST.now>=BUILT){setPlay(false);ST.now=0;ST.elapsed=0}
  T.length=BUILT;ALBUM.length=Math.min(ALBUM.length,BUILT);ST.liveEnv.length=Math.min(ST.liveEnv.length,BUILT);N=T.length;if(ST.syncN)ST.syncN();
  Q=Q.filter(i=>i<BUILT);favs=new Set([...favs].filter(i=>i<BUILT));store.set("favs",[...favs]);pls.forEach(p=>{p.s=p.s.filter(i=>i<BUILT)});savePls();recent=recent.filter(i=>i<BUILT);store.set("recent",recent);
  paint();renderSettings();toast("Added songs removed")}
 const LOADED=(async()=>{try{const rs=(await SDB.all()).sort((x,y)=>x.at-y.at);for(const r of rs)addTrack(r);if(rs.length){const sn=window.__savedNow;if(sn>=BUILT&&sn<T.length&&!ST.playing){ST.now=sn;ST.elapsed=0}paint();renderSettings()}if(rs.length){if(store.get("covfix",0)!==6){await refreshCovers(true);store.set("covfix",6)}if(store.get("artv",0)!==7){await regenArt();store.set("artv",7)}if(cfg.netcov){if(store.get("covnet",0)!==2){for(let i=BUILT;i<T.length;i++)if(T[i].cov==="tried"){T[i].cov="";await persist(i)}}if(await runNet(false))store.set("covnet",2)}}}catch(e){}})();

LOADED.then(async()=>{try{const hs=await FDB.all();FOLD=hs.map(x=>({id:x.id,name:x.name,handle:x.handle,st:""}));renderSettings();
   for(const f of FOLD){try{if(await f.handle.queryPermission({mode:"read"})==="granted")await scanFolder(f,true);else{f.st="Tap Rescan to allow access again";renderSettings()}}catch(e){}}}catch(e){}});
addEventListener("online",()=>{if(cfg.netcov)runNet(false)});
})();</script>
