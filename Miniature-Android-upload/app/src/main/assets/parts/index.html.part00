function paintFav(){$("#npfav").classList.toggle("on",favs.has(ST.now))}
function lift(c){const m=c.match(/[\d.]+/g).map(Number),r=m[0]/255,g=m[1]/255,b=m[2]/255,mx=Math.max(r,g,b),mn=Math.min(r,g,b),L=(mx+mn)/2;if(L>=.4)return c;const d=mx-mn;let s=d?d/(1-Math.abs(2*L-1)):0,h=0;if(d){h=mx===r?((g-b)/d)%6:mx===g?(b-r)/d+2:(r-g)/d+4;h*=60;if(h<0)h+=360}
 const nl=.6,ns=s>.3?Math.max(s,.55):s,C=(1-Math.abs(2*nl-1))*ns,X=C*(1-Math.abs((h/60)%2-1)),mm=nl-C/2,q=h<60?[C,X,0]:h<120?[X,C,0]:h<180?[0,C,X]:h<240?[0,X,C]:h<300?[X,0,C]:[C,0,X];return`rgb(${q.map(v=>Math.round((v+mm)*255)).join(",")})`}
function paint(){shown=ST.now;const t=T[ST.now];
 const t0=t.th;{const o=t0.c1;t0.c1=lift(o);if(t0.c1!==o){t0.rest=t0.c1.replace("rgb(","rgba(").replace(")",",.45)");t0.dot=t0.c1}}const th=curTh();app.style.setProperty("--a",t.a);app.style.setProperty("--b",th.c2);app.style.setProperty("--s",th.c1);paintWave();paintMini();
 $("#npbg").style.backgroundImage=`url(${t.img})`;$("#art").src=t.hero;$("#mimg").src=t.img;
