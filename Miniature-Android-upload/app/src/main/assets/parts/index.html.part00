 else if(!sub&&tab==="albs"){const m=[...albums()];L.innerHTML='<div class="grid">'+m.map(([n,a])=>`<div class="alb" data-alb="${esc(n)}"><img src="${T[a[0]].img}" alt=""><b>${esc(n)}</b><span>${cn(a.length,"song")}</span></div>`).join("")+"</div>";cnt=cn(m.length,"album")}
 else{songs=order();shownL=songs;const addRow=false&&!sub&&tab==="songs"?`<div class="row" data-addsongs>${tile(IC.plus)}<div class="mt"><b>Add songs from files</b><span>Pick MP3s from your phone's file manager</span></div></div>`:"",rows=songs.map((i,k)=>rowH(i)+(!sub&&tab==="songs"&&!sort&&i===BUILT-1?'<div class="bdiv"></div>':"")).join("");L.innerHTML=(sub&&sub.k==="pl"?plHead():"")+addRow+(rows||`<p class="empty">${emptyMsg()}</p>`);cnt=cn(songs.length,"song")}
 $("#cnt").textContent=cnt;$("#sortd").hidden=!songs||songs.length<2;$("#ordd").hidden=true;rq();if(window.__selPaint)__selPaint()}
