<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no,interactive-widget=resizes-content">
<meta name="theme-color" content="#080c16"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes">
<title>Miniature</title><style>
:root{--a:#241008;--b:#a15723;--s:#e5a64a;--mu:#9fb0c8;--sa:env(safe-area-inset-bottom,0px);--st:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;overflow:hidden;overscroll-behavior:none;-webkit-text-size-adjust:100%;text-size-adjust:100%;touch-action:manipulation;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;background:#03060d;color:#f5f7ff;font:15px/1.3 "Avenir Next","Segoe UI Variable",Roboto,system-ui,sans-serif}
input{-webkit-user-select:text;user-select:text}
button,input,select{font:inherit;color:inherit}
button{background:none;border:0;padding:0;cursor:pointer;display:grid;place-items:center}
svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;pointer-events:none}
#app{position:fixed;inset:0;margin:0 auto;width:100%;max-width:440px;overflow:clip;background:linear-gradient(180deg,color-mix(in srgb,var(--b) var(--tp,50%),var(--bgc,#080c16)),var(--bgc,#080c16) 60%);isolation:isolate}
@media(min-width:520px) and (min-height:760px){#app{top:max(16px,calc((100vh - 880px)/2));bottom:max(16px,calc((100vh - 880px)/2));border-radius:38px;box-shadow:0 0 0 1px #2b3856,0 30px 90px #000c}}
.view{position:absolute;inset:0 0 calc(84px + var(--sa));padding:calc(18px + var(--st)) 18px 0;display:none;flex-direction:column;min-height:0}
.view.on{display:flex}
#v-set{overflow:auto;scrollbar-width:none}#v-set>*{flex:none}
.scroll{overflow:auto;flex:1;min-height:0;margin:0 -8px;padding:0 8px;scrollbar-width:none}
h1{margin:4px 0 14px;font-size:clamp(28px,9vw,36px);font-weight:800;letter-spacing:-.8px;display:flex;justify-content:space-between;align-items:center}
.chip{display:flex;gap:6px;align-items:center;font-size:12px;font-weight:600;padding:7px 11px;border-radius:99px;background:#ffffff16;letter-spacing:0}
.chip svg{width:14px;height:14px}.chip.on{color:#4cc3ff}
.srch{display:flex;gap:8px;align-items:center;padding:0 12px;height:42px;border-radius:13px;background:#ffffff14}
.srch input{flex:1;min-width:0;background:none;border:0;outline:0;font-size:15px}
.srch svg{width:18px;height:18px;color:var(--mu)}
.bar{display:flex;justify-content:space-between;align-items:center;margin:12px 0 4px;font-size:12px;color:var(--mu)}
.bar select{background:none;border:0;color:var(--mu);outline:0;text-align:right}.bar option{color:#000}
.row{display:flex;align-items:center;gap:12px;padding:var(--rp,8px);border-radius:14px;cursor:pointer}
.row:active{background:#ffffff14}
.row.now{background:linear-gradient(90deg,color-mix(in srgb,var(--s) 22%,transparent),#ffffff0a)}
.row img,#mini img{width:var(--ri,50px);height:var(--ri,50px);border-radius:10px;object-fit:cover;flex:none;box-shadow:0 2px 8px #0008}
.mt{flex:1;min-width:0}.mt b,.mt span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mt b{font-size:calc(15px*var(--tx,1))}.mt span{font-size:calc(12px*var(--tx,1));color:var(--mu);margin-top:2px}.row.now .mt b{color:var(--s)}
.row em{font-style:normal;font-size:12px;color:var(--mu);font-variant-numeric:tabular-nums}
.fav{width:34px;height:34px;color:var(--mu)}.fav svg{width:20px}.fav.on{color:var(--s)}.fav.on svg{fill:currentColor}
.eqi{display:none;gap:2px;align-items:flex-end;height:12px}.row.now .eqi{display:flex}
.eqi u{width:3px;height:100%;background:var(--s);border-radius:1px;animation:eq .8s ease-in-out infinite alternate}
.eqi u:nth-child(2){animation-delay:-.3s}.eqi u:nth-child(3){animation-delay:-.6s}
@keyframes eq{from{height:25%}to{height:100%}}
.paused .eqi u{animation-play-state:paused}
.empty{color:var(--mu);text-align:center;margin-top:40px}
#mini{position:absolute;left:10px;right:10px;bottom:calc(12px + var(--sa));height:56px;border-radius:16px;display:flex;align-items:center;gap:10px;padding:0 6px;background:color-mix(in srgb,var(--b) 35%,#0a1020);box-shadow:0 6px 24px #0008,0 0 0 1px #ffffff18;overflow:visible;z-index:4;cursor:pointer}
#mini img{width:42px;height:42px;border-radius:9px}#v-songs{touch-action:pan-y}#m-ptr{display:none}#m-wave{width:132px;height:46px;flex:none;stroke:none;overflow:visible;padding:6px 10px;margin:-6px -2px -6px -10px;box-sizing:content-box;pointer-events:auto;touch-action:none;cursor:ew-resize}#mtip{position:absolute;right:14px;bottom:calc(100% + 8px);padding:5px 11px;border-radius:11px;background:#0a1120ee;border:1px solid #ffffff30;font-size:12.5px;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap;opacity:0;transform:translateY(4px);transition:.15s;pointer-events:none}#mtip.show{opacity:1;transform:none}.rp{width:36px;height:36px;color:var(--s);flex:none}.rp svg{width:22px;height:22px}
#mbar{position:absolute;left:0;bottom:0;height:2.5px;width:0;background:var(--s)}
#np{container-type:size;position:absolute;inset:0;z-index:20;display:flex;flex-direction:column;padding:calc(12px + var(--st)) 22px calc(18px + var(--sa));transform:translateY(102%);transition:transform .4s cubic-bezier(.3,.9,.3,1);background:#080c16;overflow:clip}
#np.open{transform:none}
#npbg{position:absolute;inset:-60px;z-index:-3;background:center/cover;filter:blur(44px) saturate(1.5);opacity:.75}
#npsh{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,#000b 0,#0000 17%,#0000 40%,color-mix(in srgb,var(--a) 70%,#050a13) 70%,#050a13)}
.npt{display:flex;justify-content:space-between;align-items:center;font-size:11px;letter-spacing:2px;font-weight:700;color:#ffffffb0;touch-action:none}.npt button{width:40px;height:40px}.npt span{visibility:hidden}
.artw{flex:1;min-height:0;display:grid;place-items:center;padding:8px 0;touch-action:none}
#art{position:absolute;left:0;top:0;width:100%;height:clamp(133.34cqw,calc(100cqh - 270px),150cqw);z-index:-1;object-fit:cover;object-position:50% 22%;-webkit-mask-image:linear-gradient(#000 80%,transparent);mask-image:linear-gradient(#000 80%,transparent);transition:filter .5s}
.paused #art{filter:brightness(.82)}
.ti{display:flex;align-items:center;gap:12px;margin:10px 0 8px;position:relative;top:32px}.ti>div{flex:1;min-width:0}
.ti h2{margin:0;font-size:calc(clamp(23px,6.6vw,27px)*var(--tx,1));font-weight:800;line-height:1.15;letter-spacing:-.6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ti p{margin:4px 0 0;color:#e4ebf7d0;font-size:calc(15.5px*var(--tx,1));font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ti .fav{width:44px;height:44px}.ti .fav svg{width:26px}
#p-wave{width:100%;height:auto;aspect-ratio:296/66;display:block;cursor:pointer;touch-action:none;overflow:visible;pointer-events:auto;stroke:none}#p-ptr{display:none}
.tms{display:flex;justify-content:space-between;font-size:12px;color:#dbe3f2b0;font-variant-numeric:tabular-nums;margin-top:4px}
.ctl{display:flex;justify-content:space-between;align-items:center;margin:14px 0 10px}
.ctl button{width:52px;height:52px;gap:1px;color:#ffffffd0}.ctl small{font-size:9px;letter-spacing:.3px;color:#ffffff99;white-space:nowrap}
.ctl .on,.ctl .on small{color:var(--s)}
#pp{width:72px;height:72px;border-radius:50%;background:var(--s);color:#10141c;box-shadow:0 8px 28px color-mix(in srgb,var(--s) 45%,transparent)}
#pp svg{width:30px;height:30px}#prev svg,#next svg{width:28px;height:28px}
.vr{display:flex;align-items:center;gap:12px;color:#ffffffb0}.vr svg{width:20px}
input[type=range]{-webkit-appearance:none;appearance:none;flex:1;height:22px;background:none;--p:50%;touch-action:none;min-width:0}
input[type=range]::-webkit-slider-runnable-track{height:4px;border-radius:4px;background:linear-gradient(90deg,var(--s) var(--p),#ffffff30 var(--p))}
input[type=range]::-moz-range-track{height:4px;border-radius:4px;background:#ffffff30}
input[type=range]::-moz-range-progress{height:4px;border-radius:4px;background:var(--s)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;margin-top:-6px;border-radius:50%;background:#fff;box-shadow:0 1px 5px #0008}
input[type=range]::-moz-range-thumb{width:16px;height:16px;border:0;border-radius:50%;background:#fff}
#qs,#es,#pk{position:absolute;left:0;right:0;bottom:0;height:62%;background:#0b1220f2;backdrop-filter:blur(20px);border-radius:24px 24px 0 0;padding:16px 16px 0;display:flex;flex-direction:column;transform:translateY(105%);transition:transform .35s cubic-bezier(.3,.9,.3,1);z-index:2}
#qs.open,#es.open,#pk.open{transform:none}.qh{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.sw{width:46px;height:28px;border-radius:14px;background:#ffffff26;justify-items:start;padding:3px;transition:.2s}
.sw i{width:22px;height:22px;border-radius:50%;background:#aaa;transition:.2s}
.sw.on{background:color-mix(in srgb,var(--s) 60%,#222)}.sw.on i{transform:translateX(18px);background:#fff}
.chips{display:flex;gap:8px;overflow:auto;margin:0 -18px 14px;padding:0 18px;scrollbar-width:none}
.chips button{padding:8px 14px;border-radius:99px;background:#ffffff14;font-size:13px;font-weight:600;flex:none}.chips .on{background:var(--s);color:#10141c}
.bands{display:flex;justify-content:space-between;gap:2px;margin-bottom:18px}
.bw{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:10px;color:var(--mu)}
.bd{position:relative;width:100%;height:200px;touch-action:none;cursor:ns-resize}
.bd:before{content:"";position:absolute;left:50%;top:0;bottom:0;width:4px;margin-left:-2px;border-radius:2px;background:#ffffff1f}
.bf{position:absolute;left:50%;width:4px;margin-left:-2px;background:var(--s);border-radius:2px}
.bk{position:absolute;left:50%;width:18px;height:18px;margin:-9px 0 0 -9px;border-radius:50%;background:#fff;box-shadow:0 2px 6px #0009}
.bw small{font-size:9px;font-variant-numeric:tabular-nums}#v-eq.off .bands{opacity:.4}
.fx{display:grid;gap:10px;padding-bottom:12px}.fx label{display:flex;align-items:center;gap:12px;font-size:13px}.fx label span{width:84px}
.card{padding:16px;border-radius:16px;background:#ffffff12;margin-bottom:14px}.card small{color:var(--mu)}.card b{display:block;font-size:30px;margin-top:4px}
.go{width:100%;padding:14px;border-radius:14px;background:color-mix(in srgb,var(--s) 22%,transparent);border:1px solid color-mix(in srgb,var(--s) 55%,transparent);font-weight:700}.go:disabled{opacity:.4}
.note{font-size:12px;color:var(--mu);line-height:1.5}
.dv{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:12px;border-radius:12px;background:#ffffff12;margin-top:8px}
.dv small{display:block;color:var(--mu)}.dv button{padding:7px 12px;border-radius:9px;background:#ffffff22;font-size:12px}
.toast{position:absolute;left:50%;top:calc(16px + var(--st));transform:translate(-50%,-8px);opacity:0;padding:9px 16px;border-radius:12px;background:#0a1120ee;border:1px solid #ffffff30;font-size:13px;transition:.2s;pointer-events:none;white-space:nowrap;z-index:50}
.toast.show{opacity:1;transform:translate(-50%,0)}
h3{margin:24px 0 10px;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:var(--mu);display:flex;justify-content:space-between;align-items:center}
.gear{width:42px;height:42px}.back{width:40px;height:40px;margin-left:-10px}
.seg{display:flex;margin:0 -4px 6px}
.seg button{flex:1;height:54px;color:#fff;transition:color .2s;position:relative}
.seg [data-t=favs].on svg{fill:currentColor}.seg svg{width:29px;height:29px}.seg .on{color:var(--s)}.seg .on svg{stroke-width:2.5}
.dd{position:relative}.ddb{display:flex;align-items:center;gap:4px;color:#dbe3f2;font-size:12.5px;font-weight:600;padding:7px 2px 7px 8px}.ddb svg{width:15px;height:15px}
.ddm{position:absolute;right:0;top:calc(100% + 8px);min-width:178px;padding:6px;border-radius:18px;background:#0f1626f4;backdrop-filter:blur(22px);box-shadow:0 18px 44px #000c,0 0 0 1px #ffffff1c;opacity:0;transform:translateY(-8px) scale(.95);transform-origin:top right;pointer-events:none;transition:.2s cubic-bezier(.3,.9,.3,1);z-index:10}
.ddm.open{opacity:1;transform:none;pointer-events:auto}
.ddm button{display:flex;justify-content:space-between;align-items:center;width:100%;padding:12px 12px;border-radius:12px;font-size:14.5px;font-weight:600;color:#e8eefc}
.ddm button:active{background:#ffffff14}.ddm svg{width:17px;height:17px;opacity:0;color:var(--s)}.ddm .on{color:var(--s)}.ddm .on svg{opacity:1}
#es{height:58%;z-index:3}#es .chips{margin:0 -16px 12px;padding:0 16px}#es .bd{height:165px}#es .bands{margin-bottom:12px}
#v-eq.off .bands{opacity:.4}
[hidden]{display:none!important}
#ttlH{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.acts{display:flex;align-items:center}.acts button{width:40px;height:42px}.acts svg{width:22px;height:22px}
.tile{width:var(--ri,50px);height:var(--ri,50px);border-radius:12px;background:#ffffff14;display:grid;place-items:center;flex:none}.tile svg{width:26px;height:26px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 14px;padding:4px 0 10px}
.alb{cursor:pointer}.alb img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:14px;box-shadow:0 8px 20px #0009;display:block}
.alb b{display:block;margin-top:9px;font-size:14.5px}.alb span{font-size:12px;color:var(--mu)}
.chk{width:26px;height:26px;border-radius:50%;border:2px solid #ffffff55;display:grid;place-items:center;flex:none}.chk.on{background:var(--s);border-color:var(--s);color:#10141c}.chk svg{width:16px;height:16px;stroke-width:3}
#pk{height:72%;z-index:30}.done{color:var(--s);font-weight:700;padding:6px 10px}
.ddg{display:flex;gap:4px;align-items:center}
#dlg{position:absolute;inset:0;z-index:60;background:#000b;display:grid;place-items:start center;padding:22vh 22px 0}
.dbox{width:100%;background:#131b2e;border-radius:22px;padding:22px;box-shadow:0 24px 70px #000d,0 0 0 1px #ffffff1a}.dbox b{display:block;font-size:18px;margin-bottom:14px}
.dbox input{width:100%;height:48px;border-radius:13px;border:1.5px solid #ffffff2a;background:#ffffff10;padding:0 14px;font-size:16px;outline:0}.dbox input:focus{border-color:var(--s)}
.dbt{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.dbt button{padding:12px 20px;border-radius:13px;font-weight:700;font-size:15px}#dok{background:var(--s);color:#10141c}#dok.danger{background:#e5484d;color:#fff}
#rot{display:none;position:fixed;inset:0;z-index:99;background:#05080f;color:#fff;place-items:center;text-align:center;padding:24px;font-size:17px;font-weight:600}
@media(orientation:landscape) and (max-height:520px) and (pointer:coarse){#rot{display:grid}}
@media(max-height:700px){.ctl{margin:8px 0 4px}#pp{width:64px;height:64px}.ti{top:24px}}
.nodur .row em{display:none}.noart .row .mt span{display:none}.nomw #m-wave{display:none}
.si{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid #ffffff10}.si.col{flex-direction:column;align-items:stretch;gap:10px}
.st{min-width:0;flex:1}.st b{display:block;font-size:15px;font-weight:600}.st span{display:block;font-size:12px;color:var(--mu);margin-top:2px;line-height:1.35}
.chs{display:flex;gap:7px;flex-wrap:wrap}.chs button{padding:8px 13px;border-radius:99px;background:#ffffff14;font-size:13px;font-weight:600}.chs .on{background:var(--s);color:#10141c}
.rgw{display:flex;align-items:center;gap:12px}.rgw .v{min-width:58px;text-align:right;font-size:13px;color:var(--mu);font-variant-numeric:tabular-nums}
.ab{padding:9px 17px;border-radius:12px;background:#ffffff1a;font-weight:700;font-size:13.5px;flex:none}.ab.danger{background:#e5484d33;color:#ff8a8d}
.sws{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.swa{width:34px;height:34px;border-radius:50%;border:2.5px solid transparent;display:grid;place-items:center;font-size:12px;font-weight:700;color:#fff;position:relative}
.swa.on{border-color:#fff}.swa.auto{background:linear-gradient(135deg,#ff6b3d,#8b7bff 55%,#3da5ff);width:auto;padding:0 14px;border-radius:99px}
.swa.cus{background:conic-gradient(#f33,#fc3,#3d6,#3cf,#63f,#f3c,#f33);overflow:hidden}.swa.cus input{position:absolute;inset:0;opacity:0;width:100%;height:100%}
.stg{display:grid;grid-template-columns:.8fr .7fr 1.5fr;gap:10px;margin-bottom:10px}.stg b{display:block;font-size:19px;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stg span{font-size:11px;color:var(--mu)}
.bar2{display:flex;align-items:center;gap:8px;margin-top:9px;font-size:12px}.bar2 span{width:104px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:none}.bar2 i{height:8px;border-radius:4px;background:var(--s);display:block}.bar2 em{font-style:normal;color:var(--mu)}
.about{text-align:center;margin:22px 0 8px}.go2{display:block;text-align:center;margin-top:8px;padding:13px;border-radius:14px;background:#ffffff14;font-weight:600;color:#fff;text-decoration:none}
.pop{position:absolute;left:50%;top:30%;width:120px;height:120px;margin:-60px 0 0 -60px;color:var(--s);animation:pop .8s ease-out forwards;pointer-events:none;z-index:5}.pop svg{width:100%;height:100%;fill:currentColor}
@keyframes pop{0%{transform:scale(.3);opacity:0}30%{transform:scale(1.15);opacity:1}100%{transform:scale(1);opacity:0}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
.npt .fav{color:#ffffffd0}.npt .fav.on{color:var(--s)}.npt .fav svg{width:24px;height:24px}
.ti #qb{width:48px;height:44px;gap:1px;color:#ffffffd0;flex:none}.ti #qb small{font-size:9px;letter-spacing:.3px;color:#ffffff99;white-space:nowrap}.ti #qb svg{width:24px;height:24px}
#sortm{display:flex;align-items:flex-start;gap:6px;width:max-content;min-width:0;padding:0;background:none;box-shadow:none;backdrop-filter:none;border-radius:0}
.mcol{padding:6px;border-radius:18px;background:#0f1626f4;backdrop-filter:blur(22px);box-shadow:0 18px 44px #000c,0 0 0 1px #ffffff1c}
#sortcol{min-width:168px}#ordcol{min-width:138px}
#mg{position:absolute;left:0;right:0;bottom:0;height:82%;background:#0b1220f8;backdrop-filter:blur(20px);border-radius:24px 24px 0 0;padding:16px 16px 0;display:flex;flex-direction:column;transform:translateY(105%);transition:transform .35s cubic-bezier(.3,.9,.3,1);z-index:31}
#mg.open{transform:none}
.abr{display:flex;gap:8px;flex-wrap:wrap}
.mgtb{display:flex;gap:8px;margin:2px 0 6px}.mgtb .ab:disabled{opacity:.4}
.mgn{margin:2px 0 8px}
#mg-list{padding-bottom:calc(14px + var(--sa))}
.row.mgr:has(.chk.on){background:#ffffff12}
.mt .src{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all;font-size:calc(11.5px*var(--tx,1));color:#c3cfe3;margin-top:3px;line-height:1.3}
.mt .src2{display:block;font-size:calc(11px*var(--tx,1));color:var(--mu);margin-top:2px}
.mgd{width:38px;height:38px;color:#ff8a8d;flex:none}.mgd svg{width:20px;height:20px}
#cp{position:absolute;left:0;right:0;bottom:0;height:86%;background:#0b1220fa;backdrop-filter:blur(20px);border-radius:24px 24px 0 0;padding:16px 16px 0;display:flex;flex-direction:column;transform:translateY(105%);transition:transform .35s cubic-bezier(.3,.9,.3,1);z-index:32}
#cp.open{transform:none}#cp .qh b{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-right:10px}
.cpn{margin:2px 0 10px}
.cpg{display:grid;grid-template-columns:1fr 1fr;gap:14px 12px;align-content:start;padding-bottom:12px}
.cpc{border:2px solid transparent;border-radius:18px;padding:6px;cursor:pointer}.cpc.on{border-color:var(--s);background:#ffffff10}.cpc.cur{opacity:.7;cursor:default}
.cpi{aspect-ratio:1;border-radius:13px;background:#ffffff12;overflow:hidden;display:grid;place-items:center}.cpi img{width:100%;height:100%;object-fit:cover;display:block}
.cpi em{font-style:normal;font-size:12px;color:var(--mu);text-align:center;padding:10px}
.cpc b{display:block;margin-top:8px;font-size:14px}.cpc small{display:block;font-size:11.5px;color:var(--mu);margin-top:2px;min-height:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#cp .mgtb{padding:6px 0 calc(14px + var(--sa))}#cp .mgtb .ab{flex:1}
.mgc{width:38px;height:38px;color:var(--s);flex:none}.mgc svg{width:20px;height:20px}
#v-songs>*,#list .row,#mini{transition:filter .28s,opacity .28s}
#list .row{transition:filter .28s,opacity .28s,transform .2s,background .2s;-webkit-touch-callout:none}
#app.sel #v-songs>*:not(#list),#app.sel #list .row:not(.picked),#app.sel #mini:not(.mclear){filter:blur(2px) brightness(.75);opacity:.8}
#app.sel #list .row{touch-action:pan-y}
.row.picked{background:linear-gradient(90deg,color-mix(in srgb,var(--s) 30%,transparent),#ffffff16)}
.row.picked::after{content:"\2713";width:24px;height:24px;border-radius:50%;background:var(--s);color:#10141c;display:grid;place-items:center;font-weight:800;font-size:14px;flex:none}
#selbar{position:absolute;left:12px;right:12px;top:calc(10px + var(--st));z-index:45;display:flex;align-items:center;gap:10px;padding:9px 10px 9px 16px;border-radius:16px;background:#0f1626f6;box-shadow:0 12px 34px #000c,0 0 0 1px #ffffff1c}
#selbar b{font-size:14px;white-space:nowrap}#selbar span{flex:1;min-width:0;font-size:11px;color:var(--mu);line-height:1.25}
#selx{padding:8px 14px;border-radius:11px;background:#ffffff1c;font-weight:700;font-size:13px}
.lnk{color:#8ec5ff!important;text-decoration:underline dotted;cursor:pointer}
.toast{max-width:92%;overflow:hidden;text-overflow:ellipsis}
#app.sel #list .plh{filter:blur(2px) brightness(.75);opacity:.8}
#cp .mgtb{flex-wrap:wrap}#cp .mgtb .ab{padding:10px 8px;font-size:12.5px;min-width:70px}
.pli{overflow:hidden;padding:0}.row .pli img,.plbig .pli img{width:100%;height:100%;border-radius:0;box-shadow:none;object-fit:cover;display:block}
.pli.mos{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:1px;background:#0006}
.pli.ph{background:linear-gradient(135deg,color-mix(in srgb,var(--s) 38%,#ffffff12),#ffffff10);color:var(--s)}.pli.ph svg{width:55%;height:55%}
.plh{display:flex;gap:14px;align-items:center;padding:2px 8px 14px}
.plbig{position:relative;flex:none;cursor:pointer;--ri:108px}.plbig .tile{border-radius:20px;box-shadow:0 10px 26px #0009}
.pled{position:absolute;right:-5px;bottom:-5px;width:30px;height:30px;border-radius:50%;background:var(--s);color:#10141c;display:grid;place-items:center;font-style:normal;box-shadow:0 2px 8px #0008}.pled svg{width:15px;height:15px}
.plm{flex:1;min-width:0}.plm b{display:block;font-size:20px;font-weight:800;letter-spacing:-.4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.plm span{display:block;font-size:12.5px;color:var(--mu);margin-top:3px}
.plbt{display:flex;gap:8px;margin-top:11px}.plbt .ab{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:9px 8px}.plbt .ab svg{width:15px;height:15px}.plbt .ab:first-child{background:var(--s);color:#10141c}
#pm,#pi{position:absolute;left:0;right:0;bottom:0;background:#0b1220fa;backdrop-filter:blur(20px);border-radius:24px 24px 0 0;padding:16px 16px calc(14px + var(--sa));display:flex;flex-direction:column;transform:translateY(105%);transition:transform .35s cubic-bezier(.3,.9,.3,1);z-index:34}
#pm.open,#pi.open{transform:none}#pi{height:78%}#pm{max-height:82%}#pi .qh .back{margin-left:-8px}
.pml{display:grid;gap:2px;overflow:auto}.pml button{display:flex;align-items:center;justify-content:flex-start;gap:14px;padding:14px 8px;border-radius:12px;font-size:15px;font-weight:600;text-align:left}.pml button svg{width:22px;height:22px;color:var(--s);flex:none}.pml button:active{background:#ffffff14}.pml .dng,.pml .dng svg{color:#ff8a8d}
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding-bottom:10px}.pit{aspect-ratio:1;border-radius:14px;overflow:hidden;border:2.5px solid transparent;padding:0;display:block}.pit.on{border-color:var(--s)}.pit img{width:100%;height:100%;object-fit:cover;display:block}
.pia{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.pia .ab{display:flex;align-items:center;gap:6px;padding:9px 13px}.pia .ab svg{width:16px;height:16px}
#app.diag .row.now .mt b{color:#fff}#app.diag .row.now{background:#00000040}
.bdiv{height:1px;margin:6px 10px 8px;background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--s) 70%,#fff) 20%,color-mix(in srgb,var(--s) 70%,#fff) 80%,transparent);opacity:.55}
#app.diag{background:linear-gradient(229deg,color-mix(in srgb,var(--s) var(--tp,50%),var(--bgc,#080c16)) 0,color-mix(in srgb,color-mix(in srgb,var(--s) var(--tp,50%),var(--bgc,#080c16)) 42%,var(--bgc,#080c16)) calc(var(--dg,55%)*.6),var(--bgc,#080c16) var(--dg,55%),var(--bgc,#080c16) 100%)}
#stat{position:absolute;top:calc(3px + var(--st));right:16px;z-index:6;display:flex;gap:10px;align-items:center;font-size:11px;font-weight:700;color:#ffffffd8;pointer-events:none;text-shadow:0 1px 4px #0008}
#stat span{display:flex;align-items:center;gap:3px}#stat svg{width:15px;height:15px}.sbt{opacity:.6}.sbt.on{opacity:1;color:#4cc3ff}.sbat.chg{color:#7be495}.sbat.low{color:#ff8a8d}
.sg{margin-top:10px;border-radius:18px;background:#ffffff0d;overflow:hidden}
.sgh{width:100%;display:flex;justify-content:space-between;align-items:center;padding:16px;font-size:16px;font-weight:700;text-align:left}
.sgh svg{width:20px;height:20px;color:var(--mu);transition:transform .25s}.sg.open .sgh svg{transform:rotate(180deg)}
.sgb{display:none;padding:0 16px 10px}.sg.open .sgb{display:block}.sgb>#set-bt>h3{display:none}.sgb .si:first-child{border-top:0}.sgb .si:last-child{border-bottom:0}
.sgs{margin:20px 0 2px;font-size:12px;letter-spacing:1.3px;text-transform:uppercase;color:var(--mu)}
.npr{display:flex;align-items:center}
#ed{position:absolute;left:0;right:0;bottom:0;height:92%;background:#0b1220fa;backdrop-filter:blur(20px);border-radius:24px 24px 0 0;padding:16px 16px 0;display:flex;flex-direction:column;transform:translateY(105%);transition:transform .35s cubic-bezier(.3,.9,.3,1);z-index:40}
#ed.open{transform:none}#ed-b{padding-bottom:10px}
.edcov{display:flex;gap:14px;align-items:center;margin:6px 0 10px}.edcov>img{width:112px;height:112px;border-radius:16px;object-fit:cover;box-shadow:0 8px 20px #0009;flex:none;background:#ffffff12}
.edcb{display:flex;flex-direction:column;gap:8px;flex:1}.edcb .ab{text-align:center}
.edres{display:flex;gap:10px;overflow-x:auto;padding:2px 0 8px}.edres:empty{display:none}.edres button{flex:none;width:84px;border:2px solid transparent;border-radius:14px;padding:3px}.edres button.on{border-color:var(--s)}.edres img{width:100%;aspect-ratio:1;border-radius:11px;object-fit:cover;display:block}.edres em{font-size:12.5px;color:var(--mu);font-style:normal;padding:8px 2px}
.edl{display:block;margin-top:14px;font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--mu)}
.edl input[type=text]{display:block;width:100%;height:48px;margin-top:6px;border-radius:13px;border:1.5px solid #ffffff2a;background:#ffffff10;padding:0 14px;font-size:16px;color:#fff;outline:0;text-transform:none;letter-spacing:0}.edl input[type=text]:focus{border-color:var(--s)}
.edtr label{display:flex;align-items:center;gap:10px;margin-top:6px;font-size:13px}.edtr label span{width:92px;flex:none}.edtr label b{font-variant-numeric:tabular-nums}
.edck{display:flex;align-items:center;gap:10px;margin:16px 0 4px;font-size:14px}.edck input{width:20px;height:20px;accent-color:var(--s)}
#ed .mgtb{padding:6px 0 calc(14px + var(--sa))}#ed .mgtb .ab{flex:1;padding:12px 8px}.ab.pri{background:var(--s);color:#000}
</style></head><body>
<div id="app" class="paused">
<section class="view on" id="v-songs">
 <h1><button id="dback" class="back" data-ic="back" aria-label="Back" hidden></button><span id="ttlH">Music</span><span class="acts"><button id="padd" data-ic="plus" aria-label="Add songs" hidden></button><button id="pren" data-ic="pencil" aria-label="Rename" hidden></button><button id="pdel" data-ic="trash" aria-label="Delete" hidden></button><button id="pmore" data-ic="more" aria-label="Playlist options" hidden></button><button id="setb" class="gear" data-ic="gear" aria-label="Settings"></button></span></h1>
 <div class="seg" id="seg"><button data-t="songs" class="on" aria-label="Songs"><span data-ic="queue"></span></button><button data-t="pls" aria-label="Playlists"><span data-ic="plist"></span></button><button data-t="favs" aria-label="Favourites"><span data-ic="heart"></span></button><button data-t="albs" aria-label="Albums"><span data-ic="album"></span></button><button data-t="rec" aria-label="Recent"><span data-ic="clock"></span></button></div>
 <div class="bar"><span id="cnt"></span><div class="ddg"><div class="dd" id="ordd" hidden><button id="ordb" class="ddb"><span id="ordl">Ascending</span><span data-ic="down"></span></button><div id="ordm" class="ddm"></div></div><div class="dd" id="sortd"><button id="sortb" class="ddb"><span id="sortl">Sort</span><span data-ic="down"></span></button><div id="sortm" class="ddm"></div></div></div></div>
 <div id="list" class="scroll"></div>
</section>
<section class="view" id="v-set">
 <h1><button id="sback" class="back" data-ic="back" aria-label="Back"></button><span>Settings</span><i style="width:30px"></i></h1>
 <div id="set-a" hidden></div><div id="set-hold" hidden></div><div id="set-groups"></div>
 <div id="set-bt"><h3>Bluetooth &amp; battery</h3>
 <div class="card"><small>Phone battery</small><b id="batbig">Unavailable</b></div>
 <button id="scan" class="go">Scan &amp; connect Bluetooth device</button><a id="btsys" class="go2" href="intent:#Intent;action=android.settings.BLUETOOTH_SETTINGS;end">Open phone Bluetooth settings</a><p id="btmsg" class="note"></p><div id="devs"></div>
 <p class="note">Headphones &amp; speakers: pair them in your phone's Bluetooth settings — music then plays through them automatically.</p></div>
<div id="set-b" hidden></div>
</section>
<div id="mini"><img id="mimg" alt=""><div class="mt"><b id="mtt"></b><span id="mar"></span></div><svg id="m-wave"></svg><span id="mtip"></span></div>
<section id="np"><div id="npbg"></div><div id="npsh"></div>
 <div class="npt" id="nptop"><button id="close" data-ic="down" aria-label="Close"></button><span>NOW PLAYING</span><div class="npr"><button id="npedit" class="fav" data-ic="pencil" aria-label="Edit song info"></button><button id="npfav" class="fav" data-ic="heart" aria-label="Favourite"></button></div></div>
 <div class="artw" id="artw"><img id="art" alt=""></div>
 <div class="ti"><div><h2 id="npt"></h2><p id="npa"></p></div><button id="qb" aria-label="Up next"><span data-ic="queue"></span><small>Up next</small></button></div>
 <svg id="p-wave" role="slider" aria-label="Seek through song"></svg><div class="tms"><span id="el">0:00</span><span id="dur">0:00</span></div>
 <div class="ctl"><button id="mode"></button><button id="prev" data-ic="prev" aria-label="Previous"></button><button id="pp" aria-label="Play/pause"></button><button id="next" data-ic="next" aria-label="Next"></button><button id="eqgo" aria-label="Equalizer"><span data-ic="eq"></span><small>Equalizer</small></button></div>
 <div id="es"><div class="qh"><b>Equalizer</b><div style="display:flex;gap:12px;align-items:center"><button id="eqsw" class="sw on" aria-label="Equalizer on/off"><i></i></button><button id="ex" data-ic="down" aria-label="Close"></button></div></div><div id="v-eq" class="scroll">
  <div id="chips" class="chips"></div><div id="bands" class="bands"></div>
 <div id="fx" class="fx"><label><span>Bass boost</span><input type="range" min="0" max="100"></label><label><span>Loudness</span><input type="range" min="0" max="100"></label><label><span>Virtualizer</span><input type="range" min="0" max="100"></label></div></div></div>
 <div id="qs"><div class="qh"><b>Up next</b><button id="qx" data-ic="down" aria-label="Close queue"></button></div><div id="q-list" class="scroll"></div></div>
</section>
<div id="cp"><div class="qh"><b id="cpt">Choose a cover</b><button id="cpx" class="done">Close</button></div><p class="note cpn" id="cpn"></p><div id="cp-g" class="cpg scroll"></div><div class="mgtb"><button id="cporig" class="ab">Original</button><button id="cpsrch" class="ab">Search…</button><button id="cpskip" class="ab">Skip</button><button id="cpuse" class="ab" disabled>Use selected</button></div></div>
<div id="mg"><div class="qh"><b id="mgt">Added songs</b><button id="mgx" class="done">Done</button></div><div class="mgtb"><button id="mgall" class="ab">Select all</button><button id="mgdel" class="ab danger" disabled>Delete</button></div><p class="note mgn">Tap a song to select it, or use the bin to delete one. Under each title is where it was chosen from; tap it to try opening that folder in your file manager (the path is also copied). Browsers hide the full phone path, so you see the folder you allowed plus the file name. Deleting removes a song from Miniature only; the original file stays on your phone.</p><div id="mg-list" class="scroll"></div></div>
<div id="ed"><div class="qh"><b>Edit song</b><button id="edx" class="done">Cancel</button></div>
 <div id="ed-b" class="scroll">
  <div class="edcov"><img id="edimg" alt=""><div class="edcb"><button class="ab" data-ec="apple">Apple Music</button><button class="ab" data-ec="spotify">Spotify</button><button class="ab" data-ec="gallery">Gallery</button></div></div>
  <div id="edres" class="edres"></div>
  <label class="edl">Title<input id="edt" type="text" maxlength="120" autocomplete="off"></label>
  <label class="edl">Artist<input id="eda" type="text" maxlength="120" autocomplete="off"></label>
  <div id="edtr" class="edtr" hidden><div class="edl">Trim</div>
   <label><span>Start <b id="edss">0:00.0</b></span><input id="edrs" type="range" min="0" max="1" step="0.1" value="0"></label>
   <label><span>End <b id="edes">0:00.0</b></span><input id="edre" type="range" min="0" max="1" step="0.1" value="1"></label>
   <p class="note" id="edl2"></p></div>
  <label class="edck"><input id="edcp" type="checkbox" checked> Also save the edited MP3 to my phone</label>
  <p class="note" id="ednote"></p>
 </div>
 <div class="mgtb"><button id="eddl" class="ab">Download file</button><button id="edsave" class="ab pri">Save changes</button></div></div>
<input type="file" id="edgal" accept="image/*" hidden>
<div id="pk"><div class="qh"><b>Add songs</b><button id="pkx" class="done">Done</button></div><div id="pk-list" class="scroll"></div></div>
<div id="pm"></div><div id="pi"></div><input type="file" id="plf" accept="image/*" hidden>
<input type="file" id="impf" accept="application/json,.json" hidden>
<div id="dlg" hidden><div class="dbox"><b id="dt"></b><input id="di" maxlength="30" autocomplete="off" enterkeyhint="done"><div class="dbt"><button id="dc">Cancel</button><button id="dok">OK</button></div></div></div>
<div id="p-toast" class="toast"></div>
<div id="selbar" hidden><b id="selc"></b><span>Tap more songs to select them. Swipe a selected song left to delete.</span><button id="selx">Cancel</button></div>
<div id="rot">Please rotate your phone to portrait</div>
</div>

<script>const ST={now:0,playing:false,elapsed:0,dragging:false,audioEl:null,liveEnv:[],mode:0,view:"player",tracks:[
 {title:"Jaan Se Guzarte Hain",artist:"Shashwat Sachdev, Khan Saab, Irshad Kamil",dur:332.251,a:"#241008",b:"#a15723",s:"#e5a64a",k:1.036,img:"data:image/jpeg;base64,",hero:"data:image/jpeg;base64,",cover:"data:image/jpeg;base64,"},
 {title:"Die With A Smile",artist:"Lady Gaga, Bruno Mars",dur:251.716,a:"#0f2e44",b:"#3b5d79",s:"#9eb8c5",k:1.475,img:"data:image/jpeg;base64,",hero:"data:image/jpeg;base64,",cover:"data:image/jpeg;base64,"},
 {title:"Dhurandhar Title Track",artist:"Hanumankind, Jasmine Sandlas, Sudhir Yaduvanshi, Muhammad Sadiq, Ranjit Kaur",dur:155.638,a:"#2b2928",b:"#7f614c",s:"#e9ecf2",k:0.914,img:"data:image/jpeg;base64,",hero:"data:image/jpeg;base64,",cover:"data:image/jpeg;base64,"},
 {title:"Baanali Jaarida",artist:"Ninaada Nayak, Rajat Hegde",dur:224.888,a:"#2c2e2b",b:"#5d7b6c",s:"#bed5c1",k:1.144,img:"data:image/jpeg;base64,",hero:"data:image/jpeg;base64,",cover:"data:image/jpeg;base64,"},
 {title:"Belageddu",artist:"Vijay Prakash, B. Ajaneesh Lokanath",dur:269.208,a:"#291a37",b:"#8a564e",s:"#e4b12b",k:1.227,img:"data:image/jpeg;base64,",hero:"data:image/jpeg;base64,",cover:"data:image/jpeg;base64,"},
 {title:"Enemy",artist:"Tommee Profitt, Beacon Light, Sam Tinnesz",dur:190.276,a:"#221a12",b:"#bc8f6f",s:"#f8ede3",k:0.861,img:"data:image/jpeg;base64,",hero:"data:image/jpeg;base64,",cover:"data:image/jpeg;base64,"}
]};window.MiniatureAudio={attach(){},setLevel(f){ST.levelFn=f}};</script>
<script>(()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],app=$("#app"),np=$("#np"),T=ST.tracks,A=()=>ST.audioEl;let N=T.length;const BUILT=T.length;
const fmt=s=>Math.floor(s/60)+":"+String(Math.floor(s%60)).padStart(2,"0");
const store={get(k,d){try{const v=localStorage.getItem("mini."+k);return v==null?d:JSON.parse(v)}catch(e){return d}},set(k,v){try{localStorage.setItem("mini."+k,JSON.stringify(v))}catch(e){}}};
