 const SEC={"Appearance":"pers","Menu & library":"lib","Playback":"aud","Sleep timer":"slp","Controls & extras":"ctl","Your listening":"lst","Data & backup":"dat"},
  G=[["pers","Personalize"],["lib","Library & songs"],["aud","Audio & playback"],["slp","Sleep timer"],["ctl","Controls"],["bt","Bluetooth & battery"],["lst","Your listening"],["dat","Data & backup"]],body={};
 G.forEach(([k])=>body[k]=document.createElement("div"));let cur="pers",cov=false;
